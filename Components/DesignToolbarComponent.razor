<!-- ════════════════════════════════════════════════════════ -->
<!--  COLOR SECTION                                           -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="tool-section">
    <div class="tool-section-head">
        <p class="tool-section-title">Colors</p>
        <div class="segmented" role="tablist">
            <button type="button" role="tab" aria-selected="@(_activeColorTab == "Shirt")"
                    class="segmented-option @(_activeColorTab == "Shirt" ? "active" : "")"
                    @onclick='() => _activeColorTab = "Shirt"'>Shirt</button>
            <button type="button" role="tab" aria-selected="@(_activeColorTab == "Background")"
                    class="segmented-option @(_activeColorTab == "Background" ? "active" : "")"
                    @onclick='() => _activeColorTab = "Background"'>Background</button>
        </div>
    </div>

    @if (_activeColorTab == "Shirt")
    {
        <div class="color-swatches">
            @foreach (var swatch in _swatches)
            {
                <div class="color-swatch @(_selectedColor == swatch ? "active" : "")"
                     style="background-color: @swatch;"
                     title="@swatch"
                     @onclick="() => SelectColor(swatch)">
                </div>
            }
        </div>
        <div style="display:flex; gap:0.75rem; align-items:center; margin-top:1rem;">
            <input type="color"
                   value="@_selectedColor"
                   id="custom-color-input"
                   style="width:40px; height:36px; border:none; border-radius:8px; cursor:pointer; background:transparent;"
                   @onchange="OnCustomColorInput" />
            <MudText Typo="Typo.caption" Style="color:#9998b3;">Custom Color</MudText>
            <MudText Typo="Typo.caption" Style="color:#5c5b7a; font-family: monospace;">@_selectedColor</MudText>
        </div>
    }
    else if (_activeColorTab == "Background")
    {
        <div class="color-swatches">
            @foreach (var swatch in _swatches)
            {
                <div class="color-swatch @(_backgroundColor == swatch ? "active" : "")"
                     style="background-color: @swatch;"
                     title="@swatch"
                     @onclick="() => SelectBgColor(swatch)">
                </div>
            }
        </div>
        <div style="display:flex; gap:0.75rem; align-items:center; margin-top:1rem;">
            <input type="color"
                   value="@_backgroundColor"
                   style="width:40px; height:36px; border:none; border-radius:8px; cursor:pointer; background:transparent;"
                   @onchange="OnCustomBgColorInput" />
            <MudText Typo="Typo.caption" Style="color:#9998b3;">Custom Background</MudText>
            <MudText Typo="Typo.caption" Style="color:#5c5b7a; font-family: monospace;">@_backgroundColor</MudText>
        </div>
    }
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!--  TEXT SECTION                                            -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="tool-section">
    <p class="tool-section-title">Text</p>
    <MudTextField @bind-Value="_textInput"
                  Label="Your Text"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  id="text-overlay-input"
                  Style="font-family:'Outfit',sans-serif;"
                  Immediate="true"
                  OnKeyUp="@(async () => await LiveUpdateText())" />
    <div style="display:flex; gap:0.75rem; margin-top:0.75rem; align-items:center;">
        <MudNumericField @bind-Value="_textSize"
                         Label="Size"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Min="12" Max="120"
                         Style="width:90px;"
                         id="text-size-input"
                         Immediate="true"
                         OnBlur="@(async () => await LiveUpdateText())" />
        <div style="flex:1;">
            <MudSelect T="string"
                       Value="@_textFont"
                       ValueChanged="ChangeFont"
                       Label="Font"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       id="text-font-select">
                @foreach (var f in _fonts)
                {
                    <MudSelectItem Value="@f">@f</MudSelectItem>
                }
            </MudSelect>
        </div>
        <input type="color"
               value="@_textColor"
               id="text-color-input"
               style="width:40px; height:40px; border:none; border-radius:8px; cursor:pointer; background:transparent;"
               @onchange="OnTextColorChange" />
    </div>
    
    @if (_isUpdating)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" Class="mt-3 tool-btn"
                   StartIcon="@Icons.Material.Filled.Check" OnClick="DeselectText">
            Done Editing
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false"
                   Class="mt-3 tool-btn" id="add-text-btn" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddText">
            Add Text
        </MudButton>
    }
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!--  2D MAP (HIDDEN, NEEDED FOR WEBGL)                       -->
<!-- ════════════════════════════════════════════════════════ -->
<div style="display: none;">
    <canvas id="fabric-canvas"></canvas>
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!--  LOGO / IMAGE SECTION                                    -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="tool-section">
    <p class="tool-section-title">Logo or Image</p>
    <InputFile id="logo-upload-input" OnChange="OnLogoSelected" accept=".png,.jpg,.jpeg,.webp"
               style="display:none;" />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="tool-btn"
               id="logo-upload-btn" StartIcon="@Icons.Material.Filled.Upload"
               OnClick="TriggerFilePicker">
        Add a Logo or Image
    </MudButton>
    <MudText Typo="Typo.caption" Class="tool-hint">PNG, JPG or WebP, up to 5 MB</MudText>
    @if (_hasLogo)
    {
        <MudText Typo="Typo.caption" Class="tool-hint tool-hint-success">
            Logo added. Drag it on the shirt to move it.
        </MudText>
    }
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!--  ACTIONS SECTION                                         -->
<!-- ════════════════════════════════════════════════════════ -->
<div class="tool-section">
    <p class="tool-section-title">Actions</p>
    <div class="tool-actions">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Class="tool-btn"
                   id="delete-selected-btn" StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteSelected">
            Delete Selected Item
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" Class="tool-btn"
                   id="clear-design-btn" StartIcon="@Icons.Material.Filled.ClearAll"
                   OnClick="ClearDesign">
            Clear Everything
        </MudButton>
    </div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public EventCallback<string> OnColorChanged { get; set; }
    [Parameter] public EventCallback<string> OnBackgroundColorChanged { get; set; }
    [Parameter] public EventCallback<(string, int, string, string)> OnTextAdded { get; set; }
    [Parameter] public EventCallback<(string, int, string, string)> OnTextUpdated { get; set; }
    [Parameter] public EventCallback<string> OnLogoUploaded { get; set; }
    [Parameter] public EventCallback OnClearDesign { get; set; }
    [Parameter] public EventCallback OnDeleteSelected { get; set; }
    [Parameter] public EventCallback OnDeselect { get; set; }

    // Color state
    private string _activeColorTab = "Shirt";
    private string _selectedColor = "#ffffff";
    private string _backgroundColor = "#f5f5f5";
    private readonly string[] _swatches =
    [
        "#ffffff", "#f8fafc", "#1e293b", "#0f172a",
        "#dc2626", "#ea580c", "#d97706", "#ca8a04",
        "#65a30d", "#16a34a", "#0d9488", "#0284c7",
        "#2563eb", "#7c3aed", "#9333ea", "#db2777",
        "#f472b6", "#fb923c", "#34d399", "#38bdf8"
    ];

    // Text state
    private string _textInput = "";
    private int _textSize = 36;
    private string _textColor = "#000000";
    private string _textFont = "Arial";
    private readonly string[] _fonts = ["Arial", "Georgia", "Impact", "Courier New", "Trebuchet MS", "Verdana"];
    
    private bool _isUpdating = false;


    // Logo state
    private bool _hasLogo = false;

    public void SetSelectedObject(Dictionary<string, object> props)
    {
        if (props.TryGetValue("type", out var type) && type?.ToString() == "text")
        {
            _isUpdating = true;
            if (props.TryGetValue("text", out var t)) _textInput = t.ToString() ?? "";
            if (props.TryGetValue("fontSize", out var s) && int.TryParse(s.ToString(), out var parsedSize)) _textSize = parsedSize;
            if (props.TryGetValue("fill", out var c)) _textColor = c.ToString() ?? "#000000";
            if (props.TryGetValue("fontFamily", out var f)) _textFont = f.ToString() ?? "Arial";
            StateHasChanged();
        }
    }

    public void ClearSelectedObject()
    {
        _isUpdating = false;
        StateHasChanged();
    }

    private async Task SelectColor(string hex)
    {
        _selectedColor = hex;
        await OnColorChanged.InvokeAsync(hex);
    }

    private async Task OnCustomColorInput(ChangeEventArgs e)
    {
        _selectedColor = e.Value?.ToString() ?? "#ffffff";
        await OnColorChanged.InvokeAsync(_selectedColor);
    }

    private async Task SelectBgColor(string hex)
    {
        _backgroundColor = hex;
        await OnBackgroundColorChanged.InvokeAsync(hex);
    }

    private async Task OnCustomBgColorInput(ChangeEventArgs e)
    {
        _backgroundColor = e.Value?.ToString() ?? "#f5f5f5";
        await OnBackgroundColorChanged.InvokeAsync(_backgroundColor);
    }

    private async Task OnTextColorChange(ChangeEventArgs e)
    {
        _textColor = e.Value?.ToString() ?? "#000000";
        await LiveUpdateText();
    }

    private async Task ChangeFont(string font)
    {
        _textFont = font;
        await LiveUpdateText();
    }

    private async Task LiveUpdateText()
    {
        if (_isUpdating)
        {
            await OnTextUpdated.InvokeAsync((_textInput, _textSize, _textColor, _textFont));
        }
    }

    private async Task AddText()
    {
        if (string.IsNullOrWhiteSpace(_textInput)) return;
        await OnTextAdded.InvokeAsync((_textInput, _textSize, _textColor, _textFont));
    }

    private async Task DeselectText()
    {
        ClearSelectedObject();
        await OnDeselect.InvokeAsync();
    }

    private async Task TriggerFilePicker()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('logo-upload-input').click()");
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5 MB
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        var dataUrl = $"data:{file.ContentType};base64,{base64}";

        _hasLogo = true;
        await OnLogoUploaded.InvokeAsync(dataUrl);
    }

    private async Task DeleteSelected()
    {
        await OnDeleteSelected.InvokeAsync();
    }

    private async Task ClearDesign()
    {
        _hasLogo = false;
        _textInput = "";
        _selectedColor = "#ffffff";
        ClearSelectedObject();
        await OnClearDesign.InvokeAsync();
    }
}
