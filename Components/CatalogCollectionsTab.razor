@using CapstoneProject.Commons
@using CapstoneProject.Dialogs
@inject CatalogService CatalogSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<ToolbarComponent SearchText="@_searchText" SearchTextChanged="@(value => _searchText = value ?? string.Empty)"
                  SearchPlaceholder="Search collections..." ShowStatusFilter="true"
                  Status="@_statusFilter" StatusChanged="@(value => _statusFilter = value)"
                  ResultText="@ResultText">
    <ActionTemplate>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddCollection">
            Add Design
        </MudButton>
    </ActionTemplate>
</ToolbarComponent>

<div class="admin-panel">
    <MudTable Items="@VisibleCollections" Dense="true" RowClassFunc="@GetRowClass" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="@_isLoading">
        <HeaderContent>
            <MudTh>Image</MudTh>
            <MudTh>Design</MudTh>
            <MudTh Class="admin-num">Price</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Class="admin-actions">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Image">
                @if (!string.IsNullOrEmpty(context.ImageUrl))
                {
                    <img src="@context.ImageUrl" alt="@context.Name" class="collection-thumb" />
                }
                else
                {
                    <div class="collection-thumb collection-thumb-empty">-</div>
                }
            </MudTd>
            <MudTd DataLabel="Design"><span class="admin-name">@context.Name</span></MudTd>
            <MudTd DataLabel="Price" Class="admin-num">₱@context.Price.ToString("N2")</MudTd>
            <MudTd DataLabel="Order">
                <MoveButtonsComponent CanMoveUp="@CanMoveUp(context)" CanMoveDown="@CanMoveDown(context)" Disabled="@(_isProcessing || IsSearching)"
                                      MoveUp="@(() => MoveItem(context, -1))" MoveDown="@(() => MoveItem(context, 1))" />
            </MudTd>
            <MudTd DataLabel="Status">
                <span class="state-badge @(context.IsActive ? "state-active" : "state-inactive")">@(context.IsActive ? "Active" : "Inactive")</span>
            </MudTd>
            <MudTd Class="admin-actions">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" AriaLabel="Actions"
                         Size="Size.Small" Dense="true" Disabled="@_isProcessing"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MenuItemsComponent Icon="@Icons.Material.Filled.Visibility" Text="Preview" Disabled="@(context.DesignData?.Parts == null)"
                                        OnItemSelect="@(() => PreviewCollection(context))" />
                    <MenuItemsComponent Icon="@Icons.Material.Filled.Edit" Text="Edit" OnItemSelect="@(() => EditCollection(context))" />
                    <MenuItemsComponent Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                        Text="@(context.IsActive ? "Deactivate" : "Activate")"
                                        OnItemSelect="@(() => ToggleActive(context))" />
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="admin-empty">No designs to show. Use "Add Design" to create one.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    #region Properties
    private List<CollectionItemModel> _collections = new();
    private bool _isLoading;
    private bool _isProcessing;
    private string? _lastMovedId;
    private string _searchText = string.Empty;
    private StatusFilter _statusFilter = StatusFilter.Active;

    private IEnumerable<CollectionItemModel> VisibleCollections => _collections
        .Where(collection => Extension.MatchesStatus(collection.IsActive, _statusFilter))
        .Where(collection => Extension.MatchesSearch(collection.Name, _searchText));

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchText);

    private string ResultText => IsSearching
        ? $"Showing {VisibleCollections.Count()} of {_collections.Count} designs. Clear the search to change the order."
        : $"Showing {VisibleCollections.Count()} of {_collections.Count} designs";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
    }
    #endregion

    #region Methods
    private async Task LoadCollections()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var collections = await CatalogSvc.GetCollectionsAsync();
            _collections = collections.Where(collection => collection.Status == CollectionStatuses.Approved).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Designs could not be loaded. Please refresh the page.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private CollectionItemModel CopyOf(CollectionItemModel collection)
    {
        return new CollectionItemModel
        {
            Id = collection.Id,
            Name = collection.Name,
            Price = collection.Price,
            ImageUrl = collection.ImageUrl,
            DesignData = collection.DesignData,
            SortOrder = collection.SortOrder,
            IsActive = collection.IsActive,
            Status = collection.Status,
            SubmittedBy = collection.SubmittedBy,
            RejectionReason = collection.RejectionReason
        };
    }

    private async Task AddCollection()
    {
        var nextOrder = _collections.Count == 0 ? 10 : _collections.Max(collection => collection.SortOrder) + 10;
        await OpenCollectionDialog(new CollectionItemModel { SortOrder = nextOrder }, true, "Add Design");
    }

    private async Task EditCollection(CollectionItemModel collection)
    {
        await OpenCollectionDialog(CopyOf(collection), false, "Edit Design");
    }

    private async Task OpenCollectionDialog(CollectionItemModel item, bool isNew, string title)
    {
        var parameters = new DialogParameters<CollectionDialog>
        {
            { x => x.Item, item },
            { x => x.IsNew, isNew }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<CollectionDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadCollections();
        }
    }

    private async Task PreviewCollection(CollectionItemModel collection)
    {
        var parameters = new DialogParameters<PreviewDesignDialog>
        {
            { x => x.Collection, collection }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        await DialogService.ShowAsync<PreviewDesignDialog>(collection.Name, parameters, options);
    }

    private bool CanMoveUp(CollectionItemModel item)
    {
        return VisibleCollections.First().Id != item.Id;
    }

    private bool CanMoveDown(CollectionItemModel item)
    {
        return VisibleCollections.Last().Id != item.Id;
    }

    private async Task MoveItem(CollectionItemModel item, int direction)
    {
        if (_isProcessing) return;

        var visibleItems = VisibleCollections.ToList();
        var index = visibleItems.FindIndex(candidate => candidate.Id == item.Id);
        var neighborIndex = index + direction;
        if (index < 0 || neighborIndex < 0 || neighborIndex >= visibleItems.Count) return;

        var isMoved = false;
        _isProcessing = true;

        try
        {
            var result = await CatalogSvc.MoveAsync(_collections, item, visibleItems[neighborIndex]);
            isMoved = result.IsSuccess;
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadCollections();

        if (isMoved)
        {
            await ShowMovedFeedback(item, direction);
        }
    }

    private async Task ShowMovedFeedback(CollectionItemModel item, int direction)
    {
        Extension.ShowAlert($"{item.Name} moved {(direction < 0 ? "up" : "down")}.", Variant.Filled, Snackbar, Severity.Success);

        _lastMovedId = item.Id;
        StateHasChanged();

        await Task.Delay(2200);
        if (_lastMovedId == item.Id)
        {
            _lastMovedId = null;
        }
    }

    private string GetRowClass(CollectionItemModel item, int rowNumber)
    {
        return item.Id == _lastMovedId ? "row-moved" : string.Empty;
    }

    private async Task ToggleActive(CollectionItemModel collection)
    {
        if (_isProcessing) return;

        if (collection.IsActive)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Deactivate Design",
                $"Customers will no longer be able to order \"{collection.Name}\". Existing orders are not affected.",
                yesText: "Deactivate",
                cancelText: "Cancel");

            if (confirmed != true) return;
        }

        _isProcessing = true;

        try
        {
            var updated = CopyOf(collection);
            updated.IsActive = !collection.IsActive;

            var result = await CatalogSvc.SaveAsync(updated, false);
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
                return;
            }

            Extension.ShowAlert($"\"{collection.Name}\" is now {(updated.IsActive ? "active" : "inactive")}.", Variant.Filled, Snackbar, Severity.Success);
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadCollections();
    }
    #endregion
}
