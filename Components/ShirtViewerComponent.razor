@inject IJSRuntime JS
@implements IAsyncDisposable

<!-- Three.js render target -->
<div id="@_containerId" class="three-canvas-container" style="position:relative; width: 100%; height: 100%;">
    @if (!_isReady)
    {
        <div class="canvas-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <p style="color:#9998b3; margin-top:1rem; font-size:0.85rem; font-family:'Outfit',sans-serif;">
                Loading 3D Model...
            </p>
        </div>
    }
    else
    {
        @if (ShowControls)
        {
            <div style="position:absolute; bottom:16px; left:50%; transform:translateX(-50%); z-index:10;">
                <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" OverrideStyles="false" Class="view-switcher">
                    <MudButton OnClick="@(() => SetCameraViewAsync("front"))">Front</MudButton>
                    <MudButton OnClick="@(() => SetCameraViewAsync("back"))">Back</MudButton>
                    <MudButton OnClick="@(() => SetCameraViewAsync("left"))">Side</MudButton>
                </MudButtonGroup>
            </div>
        }
    }
</div>



@code {
    private string _containerId = "shirt-viewer-container-" + Guid.NewGuid().ToString("N");
    private string _canvasId = "fabric-canvas-viewer-" + Guid.NewGuid().ToString("N");
    [Parameter] public bool ShowControls { get; set; } = true;
    [Parameter] public EventCallback OnModuleReady { get; set; }
    [Parameter] public string BackgroundColor { get; set; } = "#f5f5f5";

    public IJSObjectReference? Module { get; private set; }
    private bool _isReady = false;
    private DotNetObjectReference<ShirtViewerComponent>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _objRef = DotNetObjectReference.Create(this);
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shirt-viewer.js");
        await Module.InvokeVoidAsync("init", _containerId, _canvasId, _objRef, BackgroundColor);

        await Task.Delay(600); // allow model to begin loading
        _isReady = true;
        await OnModuleReady.InvokeAsync();
        StateHasChanged();
    }

    public async Task SetColorAsync(string hexColor, string target = "all")
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("setColor", hexColor, target);
    }

    public async Task SetBackgroundColorAsync(string hexColor)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("setBackgroundColor", hexColor);
    }

    public async Task AddTextAsync(string text, int fontSize, string color, string font, 
        float originX = 0, float originY = 0.2f, float originZ = 2f, 
        float dirX = 0, float dirY = 0, float dirZ = -1f)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("addText", text, fontSize, color, font, originX, originY, originZ, dirX, dirY, dirZ);
    }

    public async Task AddImageAsync(string dataUrl, float size = 0.6f, 
        float originX = 0, float originY = 0.2f, float originZ = 2f, 
        float dirX = 0, float dirY = 0, float dirZ = -1f)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("addImage", dataUrl, size, originX, originY, originZ, dirX, dirY, dirZ);
    }
    
    public async Task ApplyDesignBatchAsync(object config)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("applyDesignBatch", config);
    }


    public async Task ClearDesignAsync()
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("clearDesign");
    }
    
    public async Task SetCameraViewAsync(string view)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("setCameraView", view);
    }

    public async Task SetAutoSpinAsync(bool enable)
    {
        if (Module is null) return;
        await Module.InvokeVoidAsync("setAutoSpin", enable);
    }

    public async ValueTask DisposeAsync()
    {
        if (Module is not null)
        {
            try { await Module.InvokeVoidAsync("dispose"); } catch { }
            await Module.DisposeAsync();
        }
        _objRef?.Dispose();
    }
}
