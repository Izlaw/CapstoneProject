@using CapstoneProject.Commons
@using CapstoneProject.Dialogs
@inject CatalogService CatalogSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<ToolbarComponent SearchText="@_searchText" SearchTextChanged="@(value => _searchText = value ?? string.Empty)"
                  SearchPlaceholder="Search fabrics..." ShowStatusFilter="true"
                  Status="@_statusFilter" StatusChanged="@(value => _statusFilter = value)"
                  ResultText="@ResultText">
    <ActionTemplate>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddFabric">
            Add Fabric
        </MudButton>
    </ActionTemplate>
</ToolbarComponent>

<div class="admin-panel">
    <MudTable Items="@VisibleFabrics" RowClassFunc="@GetRowClass" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="@_isLoading">
        <HeaderContent>
            <MudTh>Fabric</MudTh>
            <MudTh Class="admin-num">Price</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Class="admin-actions">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fabric"><span class="admin-name">@context.Name</span></MudTd>
            <MudTd DataLabel="Price" Class="admin-num">₱@context.Price.ToString("N2")</MudTd>
            <MudTd DataLabel="Order">
                <MoveButtonsComponent CanMoveUp="@CanMoveUp(context)" CanMoveDown="@CanMoveDown(context)" Disabled="@(_isProcessing || IsSearching)"
                                      MoveUp="@(() => MoveItem(context, -1))" MoveDown="@(() => MoveItem(context, 1))" />
            </MudTd>
            <MudTd DataLabel="Status">
                <span class="state-badge @(context.IsActive ? "state-active" : "state-inactive")">@(context.IsActive ? "Active" : "Inactive")</span>
            </MudTd>
            <MudTd Class="admin-actions">
                <MudMenu Label="Actions" EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text" Color="Color.Primary"
                         Size="Size.Small" Dense="true" Disabled="@_isProcessing"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MenuItemsComponent Icon="@Icons.Material.Filled.Edit" Text="Edit" OnItemSelect="@(() => EditFabric(context))" />
                    <MenuItemsComponent Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                        Text="@(context.IsActive ? "Deactivate" : "Activate")"
                                        OnItemSelect="@(() => ToggleActive(context))" />
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="admin-empty">No fabrics to show. Use "Add Fabric" to create one.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    #region Properties
    private List<FabricModel> _fabrics = new();
    private bool _isLoading;
    private bool _isProcessing;
    private string? _lastMovedId;
    private string _searchText = string.Empty;
    private StatusFilter _statusFilter = StatusFilter.Active;

    private IEnumerable<FabricModel> VisibleFabrics => _fabrics
        .Where(fabric => Extension.MatchesStatus(fabric.IsActive, _statusFilter))
        .Where(fabric => Extension.MatchesSearch(fabric.Name, _searchText));

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchText);

    private string ResultText => IsSearching
        ? $"Showing {VisibleFabrics.Count()} of {_fabrics.Count} fabrics. Clear the search to change the order."
        : $"Showing {VisibleFabrics.Count()} of {_fabrics.Count} fabrics";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadFabrics();
    }
    #endregion

    #region Methods
    private async Task LoadFabrics()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            _fabrics = await CatalogSvc.GetFabricsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Fabrics could not be loaded. Please refresh the page.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private FabricModel CopyOf(FabricModel fabric)
    {
        return new FabricModel
        {
            Id = fabric.Id,
            Name = fabric.Name,
            Price = fabric.Price,
            RequiresNote = fabric.RequiresNote,
            SortOrder = fabric.SortOrder,
            IsActive = fabric.IsActive
        };
    }

    private async Task AddFabric()
    {
        var nextOrder = _fabrics.Count == 0 ? 10 : _fabrics.Max(fabric => fabric.SortOrder) + 10;
        await OpenFabricDialog(new FabricModel { SortOrder = nextOrder }, true, "Add Fabric");
    }

    private async Task EditFabric(FabricModel fabric)
    {
        await OpenFabricDialog(CopyOf(fabric), false, "Edit Fabric");
    }

    private async Task OpenFabricDialog(FabricModel item, bool isNew, string title)
    {
        var parameters = new DialogParameters<FabricDialog>
        {
            { x => x.Item, item },
            { x => x.IsNew, isNew }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<FabricDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadFabrics();
        }
    }

    private bool CanMoveUp(FabricModel item)
    {
        return VisibleFabrics.First().Id != item.Id;
    }

    private bool CanMoveDown(FabricModel item)
    {
        return VisibleFabrics.Last().Id != item.Id;
    }

    private async Task MoveItem(FabricModel item, int direction)
    {
        if (_isProcessing) return;

        var visibleItems = VisibleFabrics.ToList();
        var index = visibleItems.FindIndex(candidate => candidate.Id == item.Id);
        var neighborIndex = index + direction;
        if (index < 0 || neighborIndex < 0 || neighborIndex >= visibleItems.Count) return;

        var isMoved = false;
        _isProcessing = true;

        try
        {
            var result = await CatalogSvc.MoveAsync(_fabrics, item, visibleItems[neighborIndex]);
            isMoved = result.IsSuccess;
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadFabrics();

        if (isMoved)
        {
            await ShowMovedFeedback(item, direction);
        }
    }

    private async Task ShowMovedFeedback(FabricModel item, int direction)
    {
        Extension.ShowAlert($"{item.Name} moved {(direction < 0 ? "up" : "down")}.", Variant.Filled, Snackbar, Severity.Success);

        _lastMovedId = item.Id;
        StateHasChanged();

        await Task.Delay(2200);
        if (_lastMovedId == item.Id)
        {
            _lastMovedId = null;
        }
    }

    private string GetRowClass(FabricModel item, int rowNumber)
    {
        return item.Id == _lastMovedId ? "row-moved" : string.Empty;
    }

    private async Task ToggleActive(FabricModel fabric)
    {
        if (_isProcessing) return;

        if (fabric.IsActive)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Deactivate Fabric",
                $"Customers will no longer be able to choose {fabric.Name}. Existing orders are not affected.",
                yesText: "Deactivate",
                cancelText: "Cancel");

            if (confirmed != true) return;
        }

        _isProcessing = true;

        try
        {
            var updated = CopyOf(fabric);
            updated.IsActive = !fabric.IsActive;

            var result = await CatalogSvc.SaveAsync(updated, false);
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
                return;
            }

            Extension.ShowAlert($"{fabric.Name} is now {(updated.IsActive ? "active" : "inactive")}.", Variant.Filled, Snackbar, Severity.Success);
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadFabrics();
    }
    #endregion
}
