@inject ISnackbar Snackbar
@using CapstoneProject.Commons

<div class="export-section">
    <p class="tool-section-title">Order</p>

    <OrderFormComponent @ref="_orderForm" OrderType="custom" Disabled="@IsSaving" />

    <div class="order-actions">
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false"
                           Disabled="@IsSaving" StartIcon="@Icons.Material.Filled.ShoppingCart" OnClick="PlaceOrder">
                    @if (IsSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Placing Your Order...</span>
                    }
                    else
                    {
                        <span>Place Order</span>
                    }
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false"
                           StartIcon="@Icons.Material.Filled.Login">
                    Sign In to Place Your Order
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Disabled="@IsSaving"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => OnExport.InvokeAsync())">
            Download Preview Image
        </MudButton>
    </div>

    <MudText Typo="Typo.caption" Class="order-tip">Tip: drag to rotate the shirt and scroll to zoom.</MudText>
</div>

@code {
    #region Properties
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback<OrderRequestModel> OnCheckout { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    private OrderFormComponent _orderForm = default!;
    #endregion

    #region Methods
    private async Task PlaceOrder()
    {
        var message = _orderForm.GetValidationMessage();
        if (message != null)
        {
            Extension.ShowAlert(message, Variant.Filled, Snackbar, Severity.Warning);
            return;
        }

        await OnCheckout.InvokeAsync(_orderForm.BuildRequest());
    }
    #endregion
}
