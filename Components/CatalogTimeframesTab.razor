@using CapstoneProject.Commons
@using CapstoneProject.Dialogs
@inject CatalogService CatalogSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<ToolbarComponent SearchText="@_searchText" SearchTextChanged="@(value => _searchText = value ?? string.Empty)"
                  SearchPlaceholder="Search timeframes..." ShowStatusFilter="true"
                  Status="@_statusFilter" StatusChanged="@(value => _statusFilter = value)"
                  ResultText="@ResultText">
    <ActionTemplate>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddTimeframe">
            Add Timeframe
        </MudButton>
    </ActionTemplate>
</ToolbarComponent>

<div class="admin-panel">
    <MudTable Items="@VisibleTimeframes" Dense="true" RowClassFunc="@GetRowClass" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="@_isLoading">
        <HeaderContent>
            <MudTh>Timeframe</MudTh>
            <MudTh Class="admin-num">Fee</MudTh>
            <MudTh Class="admin-num">Max Pieces per Order</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Class="admin-actions">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Timeframe"><span class="admin-name">@context.Label</span></MudTd>
            <MudTd DataLabel="Fee" Class="admin-num">@context.SurchargePercent.ToString("0.##")%</MudTd>
            <MudTd DataLabel="Max Pieces per Order" Class="admin-num">@(context.MaxQuantity?.ToString("N0") ?? "No limit")</MudTd>
            <MudTd DataLabel="Order">
                <MoveButtonsComponent CanMoveUp="@CanMoveUp(context)" CanMoveDown="@CanMoveDown(context)" Disabled="@(_isProcessing || IsSearching)"
                                      MoveUp="@(() => MoveItem(context, -1))" MoveDown="@(() => MoveItem(context, 1))" />
            </MudTd>
            <MudTd DataLabel="Status">
                <span class="state-badge @(context.IsActive ? "state-active" : "state-inactive")">@(context.IsActive ? "Active" : "Inactive")</span>
            </MudTd>
            <MudTd Class="admin-actions">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" AriaLabel="Actions"
                         Size="Size.Small" Dense="true" Disabled="@_isProcessing"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MenuItemsComponent Icon="@Icons.Material.Filled.Edit" Text="Edit" OnItemSelect="@(() => EditTimeframe(context))" />
                    <MenuItemsComponent Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                        Text="@(context.IsActive ? "Deactivate" : "Activate")"
                                        OnItemSelect="@(() => ToggleActive(context))" />
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="admin-empty">No timeframes to show. Use "Add Timeframe" to create one.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    #region Properties
    private List<TimeframeModel> _timeframes = new();
    private bool _isLoading;
    private bool _isProcessing;
    private string? _lastMovedId;
    private string _searchText = string.Empty;
    private StatusFilter _statusFilter = StatusFilter.Active;

    private IEnumerable<TimeframeModel> VisibleTimeframes => _timeframes
        .Where(timeframe => Extension.MatchesStatus(timeframe.IsActive, _statusFilter))
        .Where(timeframe => Extension.MatchesSearch(timeframe.Label, _searchText));

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchText);

    private string ResultText => IsSearching
        ? $"Showing {VisibleTimeframes.Count()} of {_timeframes.Count} timeframes. Clear the search to change the order."
        : $"Showing {VisibleTimeframes.Count()} of {_timeframes.Count} timeframes";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadTimeframes();
    }
    #endregion

    #region Methods
    private async Task LoadTimeframes()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            _timeframes = await CatalogSvc.GetTimeframesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Timeframes could not be loaded. Please refresh the page.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private TimeframeModel CopyOf(TimeframeModel timeframe)
    {
        return new TimeframeModel
        {
            Id = timeframe.Id,
            Label = timeframe.Label,
            SurchargePercent = timeframe.SurchargePercent,
            MaxQuantity = timeframe.MaxQuantity,
            SortOrder = timeframe.SortOrder,
            IsActive = timeframe.IsActive
        };
    }

    private async Task AddTimeframe()
    {
        var nextOrder = _timeframes.Count == 0 ? 10 : _timeframes.Max(timeframe => timeframe.SortOrder) + 10;
        await OpenTimeframeDialog(new TimeframeModel { SortOrder = nextOrder }, true, "Add Timeframe");
    }

    private async Task EditTimeframe(TimeframeModel timeframe)
    {
        await OpenTimeframeDialog(CopyOf(timeframe), false, "Edit Timeframe");
    }

    private async Task OpenTimeframeDialog(TimeframeModel item, bool isNew, string title)
    {
        var parameters = new DialogParameters<TimeframeDialog>
        {
            { x => x.Item, item },
            { x => x.IsNew, isNew }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<TimeframeDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadTimeframes();
        }
    }

    private bool CanMoveUp(TimeframeModel item)
    {
        return VisibleTimeframes.First().Id != item.Id;
    }

    private bool CanMoveDown(TimeframeModel item)
    {
        return VisibleTimeframes.Last().Id != item.Id;
    }

    private async Task MoveItem(TimeframeModel item, int direction)
    {
        if (_isProcessing) return;

        var visibleItems = VisibleTimeframes.ToList();
        var index = visibleItems.FindIndex(candidate => candidate.Id == item.Id);
        var neighborIndex = index + direction;
        if (index < 0 || neighborIndex < 0 || neighborIndex >= visibleItems.Count) return;

        var isMoved = false;
        _isProcessing = true;

        try
        {
            var result = await CatalogSvc.MoveAsync(_timeframes, item, visibleItems[neighborIndex]);
            isMoved = result.IsSuccess;
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadTimeframes();

        if (isMoved)
        {
            await ShowMovedFeedback(item, direction);
        }
    }

    private async Task ShowMovedFeedback(TimeframeModel item, int direction)
    {
        Extension.ShowAlert($"{item.Label} moved {(direction < 0 ? "up" : "down")}.", Variant.Filled, Snackbar, Severity.Success);

        _lastMovedId = item.Id;
        StateHasChanged();

        await Task.Delay(2200);
        if (_lastMovedId == item.Id)
        {
            _lastMovedId = null;
        }
    }

    private string GetRowClass(TimeframeModel item, int rowNumber)
    {
        return item.Id == _lastMovedId ? "row-moved" : string.Empty;
    }

    private async Task ToggleActive(TimeframeModel timeframe)
    {
        if (_isProcessing) return;

        if (timeframe.IsActive)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Deactivate Timeframe",
                $"Customers will no longer be able to choose \"{timeframe.Label}\". Existing orders are not affected.",
                yesText: "Deactivate",
                cancelText: "Cancel");

            if (confirmed != true) return;
        }

        _isProcessing = true;

        try
        {
            var updated = CopyOf(timeframe);
            updated.IsActive = !timeframe.IsActive;

            var result = await CatalogSvc.SaveAsync(updated, false);
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
                return;
            }

            Extension.ShowAlert($"\"{timeframe.Label}\" is now {(updated.IsActive ? "active" : "inactive")}.", Variant.Filled, Snackbar, Severity.Success);
        }
        finally
        {
            _isProcessing = false;
        }

        await LoadTimeframes();
    }
    #endregion
}
