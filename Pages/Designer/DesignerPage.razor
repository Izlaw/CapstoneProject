@page "/designer"
@using System.Text.RegularExpressions
@using CapstoneProject.Commons
@inject DesignService DesignSvc
@inject ExportService ExportSvc
@inject OrderService OrderSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager
@implements IAsyncDisposable

<PageTitle>Designer - 7 Guys House of Fashion</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveDesigner" ConfirmExternalNavigation="@_hasUnsavedDesign" />

<div class="designer-layout">
    <div class="designer-canvas-area">
        <div class="designer-back"><BackButtonComponent Href="/add-order" Text="Back to New Order" /></div>
        <ShirtCanvasComponent @ref="_shirtCanvas"
                              OnModuleReady="OnModuleReady"
                              OnObjectSelected="OnObjectSelected"
                              OnObjectCleared="OnObjectCleared" />
    </div>
    <div class="designer-tools-area">
        <DesignToolbarComponent @ref="_toolbar"
            OnColorChanged="ChangeShirtColor"
            OnBackgroundColorChanged="ChangeBackgroundColor"
            OnTextAdded="AddText"
            OnTextUpdated="UpdateText"
            OnLogoUploaded="AddLogo"
            OnClearDesign="ClearDesign"
            OnDeleteSelected="DeleteSelected"
            OnDeselect="DeselectObject" />

        <ExportPanelComponent
            OnExport="DownloadPreview"
            OnCheckout="PlaceOrder"
            IsSaving="_isSaving" />
    </div>
</div>

@code {
    #region Properties
    private static readonly HashSet<string> AllowedImageTypes = new() { "image/png", "image/jpeg", "image/webp" };
    private static readonly Regex HexColorPattern = new("^#[0-9A-Fa-f]{6}$");
    private readonly List<string> _uploadedPaths = new();

    private ShirtCanvasComponent _shirtCanvas = default!;
    private DesignToolbarComponent _toolbar = default!;
    private bool _isSaving;
    private bool _hasUnsavedDesign;
    #endregion

    #region Lifecycle
    public async ValueTask DisposeAsync()
    {
        await _shirtCanvas.DisposeAsync();
    }
    #endregion

    #region Canvas events
    private void OnModuleReady()
    {
        StateHasChanged();
    }

    private void OnObjectSelected(Dictionary<string, object> properties)
    {
        _toolbar.SetSelectedObject(properties);
    }

    private void OnObjectCleared()
    {
        _toolbar.ClearSelectedObject();
    }

    private async Task ChangeShirtColor((string Target, string Hex) args)
    {
        if (args.Target is "all" or "body")
        {
            DesignSvc.SetColor(args.Hex);
        }
        await _shirtCanvas.SetColorAsync(args.Hex, args.Target);
        _hasUnsavedDesign = true;
    }

    private async Task ChangeBackgroundColor(string hex)
    {
        await _shirtCanvas.SetBackgroundColorAsync(hex);
    }

    private async Task AddText((string text, int size, string color, string font) args)
    {
        DesignSvc.SetTextOverlay(args.text, args.size, args.color, args.font);
        await _shirtCanvas.AddTextAsync(args.text, args.size, args.color, args.font);
        _hasUnsavedDesign = true;
    }

    private async Task UpdateText((string text, int size, string color, string font) args)
    {
        await _shirtCanvas.UpdateSelectedTextAsync(args.text, args.size, args.color, args.font);
        _hasUnsavedDesign = true;
    }

    private async Task AddLogo(string dataUrl)
    {
        DesignSvc.SetLogo(dataUrl);
        await _shirtCanvas.AddImageAsync(dataUrl);
        _hasUnsavedDesign = true;
    }

    private async Task ClearDesign()
    {
        DesignSvc.ClearDesign();
        await _shirtCanvas.ClearDesignAsync();
        await _shirtCanvas.SetColorAsync("#ffffff");
        _hasUnsavedDesign = false;
    }

    private async Task DeleteSelected()
    {
        await _shirtCanvas.DeleteSelectedAsync();
        _hasUnsavedDesign = true;
    }

    private async Task DeselectObject()
    {
        await _shirtCanvas.DeselectActiveObjectAsync();
    }

    private async Task DownloadPreview()
    {
        if (_shirtCanvas.Module is null) return;
        await ExportSvc.DownloadPngAsync(_shirtCanvas.Module);
    }

    private async Task ConfirmLeaveDesigner(LocationChangingContext context)
    {
        if (!_hasUnsavedDesign) return;

        var isLeaving = await DialogService.ShowMessageBox(
            "Leave the Designer?",
            "Your design has not been ordered yet. If you leave now, it will be lost.",
            yesText: "Leave",
            cancelText: "Stay");

        if (isLeaving != true)
        {
            context.PreventNavigation();
        }
    }
    #endregion

    #region Checkout
    private async Task PlaceOrder(OrderRequestModel request)
    {
        if (_isSaving || _shirtCanvas.Module is null) return;

        var parts = await _shirtCanvas.GetPartColorsAsync();
        var shirtColor = parts.Body;
        if (!HexColorPattern.IsMatch(shirtColor) || parts.GetAllColors().Any(color => !HexColorPattern.IsMatch(color)))
        {
            Extension.ShowAlert("Choose a shirt color first.", Variant.Filled, Snackbar, Severity.Warning);
            return;
        }

        _isSaving = true;
        _uploadedPaths.Clear();
        var orderPlaced = false;

        try
        {
            var previewPath = await UploadPreviewAsync();
            if (previewPath == null) return;

            var elements = await UploadDesignElementsAsync();
            if (elements == null) return;

            request.ShirtColor = shirtColor;
            request.DesignData = new DesignDataModel { Elements = elements, Parts = parts };
            request.ImagePath = previewPath;

            var result = await OrderSvc.PlaceOrderAsync(request);
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
                return;
            }

            orderPlaced = true;
            _hasUnsavedDesign = false;
            await ShowOrderPlacedDialog(result.Value!);
            NavManager.NavigateTo($"/order-preview/{result.Value}?placed=true");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Something went wrong while placing your order. Please try again.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            if (!orderPlaced) await OrderSvc.DeleteImagesAsync(_uploadedPaths);
            _isSaving = false;
        }
    }

    private async Task<string?> UploadPreviewAsync()
    {
        var dataUrl = await _shirtCanvas.Module!.InvokeAsync<string>("exportPng");
        if (!TryReadDataUrl(dataUrl, out var bytes, out var contentType))
        {
            Extension.ShowAlert("The design preview could not be created. Please try again.", Variant.Filled, Snackbar, Severity.Error);
            return null;
        }

        var upload = await OrderSvc.UploadImageAsync(bytes, contentType);
        if (!upload.IsSuccess)
        {
            Extension.ShowAlert(upload.Message, Variant.Filled, Snackbar, Severity.Error);
            return null;
        }

        _uploadedPaths.Add(upload.Value!);
        return upload.Value;
    }

    private async Task<List<DesignElementModel>?> UploadDesignElementsAsync()
    {
        var elements = await _shirtCanvas.Module!.InvokeAsync<List<DesignElementModel>>("getDesignElements");

        foreach (var element in elements.Where(item => item.Type == "image"))
        {
            if (!TryReadDataUrl(element.DataUrl, out var bytes, out var contentType) || !AllowedImageTypes.Contains(contentType))
            {
                Extension.ShowAlert("Logos and images must be PNG, JPG or WebP files.", Variant.Filled, Snackbar, Severity.Warning);
                return null;
            }

            var upload = await OrderSvc.UploadImageAsync(bytes, contentType);
            if (!upload.IsSuccess)
            {
                Extension.ShowAlert(upload.Message, Variant.Filled, Snackbar, Severity.Error);
                return null;
            }

            _uploadedPaths.Add(upload.Value!);
            element.Path = upload.Value;
            element.DataUrl = null;
        }

        return elements;
    }

    private async Task ShowOrderPlacedDialog(string orderId)
    {
        var shareToken = await OrderSvc.GetShareTokenAsync(orderId);
        var previewUrl = shareToken.IsSuccess
            ? NavManager.ToAbsoluteUri($"/shared/{shareToken.Value}").ToString()
            : string.Empty;

        var parameters = new DialogParameters<OrderSuccessDialog>
        {
            { x => x.OrderId, orderId },
            { x => x.PreviewUrl, previewUrl }
        };
        var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small };

        var dialog = await DialogService.ShowAsync<OrderSuccessDialog>("Order placed", parameters, options);
        await dialog.Result;
    }

    private static bool TryReadDataUrl(string? dataUrl, out byte[] bytes, out string contentType)
    {
        bytes = Array.Empty<byte>();
        contentType = string.Empty;

        if (string.IsNullOrEmpty(dataUrl) || !dataUrl.StartsWith("data:")) return false;

        var separatorIndex = dataUrl.IndexOf(";base64,", StringComparison.Ordinal);
        if (separatorIndex < 0) return false;

        contentType = dataUrl.Substring(5, separatorIndex - 5);

        try
        {
            bytes = Convert.FromBase64String(dataUrl.Substring(separatorIndex + ";base64,".Length));
            return bytes.Length > 0;
        }
        catch (FormatException)
        {
            return false;
        }
    }
    #endregion
}
