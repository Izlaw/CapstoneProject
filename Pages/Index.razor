@page "/"
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Home — 7 Guys House of Fashion</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="home-container">
    <MudGrid Spacing="0" Class="hero-grid">
        
        <!-- Left Column -->
        <MudItem xs="12" md="5" lg="4" Class="d-flex flex-column justify-center px-8 px-md-16">
            <MudText Typo="Typo.h1" Class="hero-title">
                <span style="font-weight: 600;">YOU</span> design.<br/>
                <span style="font-weight: 600;">WE</span> create.
            </MudText>
            <MudText Typo="Typo.h6" Class="hero-subtitle mt-4">
                What you design, we bring to reality.
            </MudText>
            
            <div class="d-flex flex-wrap gap-4 mt-8">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="HandleAddOrder" Class="hero-btn">
                    Start Customizing
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" OnClick="HandleViewOrder" Class="hero-btn hero-btn-outline">
                    Track Order
                </MudButton>
            </div>
        </MudItem>

        <!-- Right Column -->
        <MudItem xs="12" md="7" lg="8" Class="hero-visual pa-0">
            <div class="hero-3d-wrapper">
                <ShirtCanvasComponent @ref="_shirtCanvas" OnModuleReady="OnShirtReady" ShowControls="false" />
            </div>
            <canvas id="fabric-canvas" style="display:none;"></canvas>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {
    private ShirtCanvasComponent? _shirtCanvas;
    private CancellationTokenSource _cts = new();
    
    private readonly string[] _colors = { "#B51A2B", "#541A2E", "#FFA586", "#161E2F", "#242E49", "#384358", "#FFFFFF", "#000000" };
    private readonly string[] _fonts = { "Outfit", "Arial", "Impact", "Courier New", "Georgia" };
    private readonly string[] _texts = { "BESPOKE", "7 GUYS", "STYLE", "3D", "CUSTOM", "FASHION", "MINIMAL" };

    private async Task OnShirtReady()
    {
        if (_shirtCanvas == null) return;
        
        // Enable Auto Spin to captivate attention
        await _shirtCanvas.SetAutoSpinAsync(true);
        
        // Start the background loop
        _ = RunRandomizerLoopAsync();
    }

    private async Task RunRandomizerLoopAsync()
    {
        var random = new Random();
        while (!_cts.Token.IsCancellationRequested)
        {
            if (_shirtCanvas == null) break;
            
            // Clear previous design
            await _shirtCanvas.ClearDesignAsync();

            // Pick a random background color
            var bgColor = _colors[random.Next(_colors.Length)];
            await _shirtCanvas.SetColorAsync(bgColor);
            
            // Add random text
            var text = _texts[random.Next(_texts.Length)];
            var font = _fonts[random.Next(_fonts.Length)];
            
            // Ensure contrast
            var textColor = (bgColor == "#FFFFFF" || bgColor == "#FFA586") ? "#161E2F" : "#FFFFFF"; 
            
            var fontSize = random.Next(40, 75);
            
            await _shirtCanvas.AddTextAsync(text, fontSize, textColor, font);
            
            try
            {
                // Wait 1.5 seconds before generating the next design
                await Task.Delay(1500, _cts.Token);
            }
            catch (TaskCanceledException)
            {
                break;
            }
        }
    }

    private async Task HandleAddOrder()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/add-order");
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    private async Task HandleViewOrder()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/dashboard");
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}

<style>
    /* 1. Layout Enforcers */
    .home-container {
        height: calc(100vh - 64px);
        overflow-y: hidden;
        background-color: var(--mud-palette-background);
        display: flex;
        padding: 0;
    }
    
    .hero-grid {
        flex-grow: 1;
        margin: 0;
    }

    .hero-visual {
        height: calc(100vh - 64px);
        position: relative;
    }

    .hero-3d-wrapper {
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    /* 2. Typography & Buttons */
    .hero-title, .hero-subtitle, .hero-btn {
        font-family: 'Outfit', sans-serif;
    }

    .hero-title {
        font-weight: 200;
        line-height: 1.1;
        letter-spacing: -0.04em;
        font-size: clamp(3.5rem, 5vw, 5.5rem);
        color: var(--mud-palette-text-primary);
    }

    .hero-subtitle {
        font-weight: 300;
        color: var(--mud-palette-text-secondary);
        max-width: 450px;
    }

    .hero-btn {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0.75rem 2.5rem !important;
        border-radius: 50px;
        background: linear-gradient(135deg, #e62424 0%, #b30000 100%);
        box-shadow: 0 4px 15px rgba(230, 36, 36, 0.3);
        color: white;
        transition: all 0.3s ease;
        border: none;
    }

    .hero-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(230, 36, 36, 0.5);
    }

    .hero-btn-outline {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: none;
    }

    .hero-btn-outline:hover {
        border-color: rgba(255, 255, 255, 0.6);
        box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    /* 3. Third-Party Canvas Overrides */
    ::deep .three-canvas-container {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }
</style>