@page "/"

<PageTitle>7 Guys House of Fashion</PageTitle>

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title" style="text-align: left;">
            Custom Fashion,<br />
            <span class="gradient-text">Tailored for You</span>
        </h1>
        <p class="hero-subtitle" style="text-align: left;">
            Experience the future of fashion. Design your own bespoke garments using our interactive 3D studio, 
            or browse our exclusive collection of ready-to-wear pieces.
        </p>
        <div class="hero-cta" style="justify-content: flex-start;">
            <a href="/designer" class="cta-primary" id="hero-start-btn">
                Customize Now
            </a>
            <a href="/gallery" class="cta-secondary" id="hero-learn-btn">
                View Collection
            </a>
        </div>
    </div>
    
    <div class="hero-image-wrapper">
        <img src="/images/hero_shirt.png" alt="Premium Tailored Shirt" class="hero-image" />
    </div>
</div>

<!-- Features Section -->
<div id="features" class="features-section">
    <div class="section-header">
        <p class="section-label">Our Services</p>
        <h2 class="section-title">Design Without Limits</h2>
    </div>
    <div class="features-grid">
        <div class="feature-card" id="feature-color">
            <div class="feature-icon">🎨</div>
            <div class="feature-title">Real-Time Customization</div>
            <p class="feature-desc">Choose from curated palettes or any custom hex color. The 3D shirt updates instantly.</p>
        </div>
        <div class="feature-card" id="feature-text">
            <div class="feature-icon">✏️</div>
            <div class="feature-title">Text &amp; Logos</div>
            <p class="feature-desc">Add custom text or upload your own artwork. Scale and position to perfection.</p>
        </div>
        <div class="feature-card" id="feature-rotate">
            <div class="feature-icon">🔄</div>
            <div class="feature-title">360° Preview</div>
            <p class="feature-desc">Rotate, zoom, and inspect every angle of your garment before placing an order.</p>
        </div>
        <div class="feature-card" id="feature-save">
            <div class="feature-icon">🛍️</div>
            <div class="feature-title">Seamless Ordering</div>
            <p class="feature-desc">Submit your bespoke design directly to our tailoring team for production.</p>
        </div>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
        <a href="/designer" class="cta-primary" id="features-cta-btn" style="display:inline-flex;">
            Start Your Custom Order
        </a>
    </div>
</div>
