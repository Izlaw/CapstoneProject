@page "/"
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Home - 7 Guys House of Fashion</PageTitle>

<section class="home-hero">
    <div class="home-copy">
        <span class="home-eyebrow">Custom Apparel Studio</span>
        <h1 class="home-title">
            <strong>YOU</strong> design.<br />
            <strong class="home-title-accent">WE</strong> create.
        </h1>
        <p class="home-lead">What you design, we bring to reality.</p>

        <div class="home-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" DropShadow="false"
                       OnClick="StartCustomizing" Class="home-btn">
                Start Customizing
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                       OnClick="TrackOrder" Class="home-btn home-btn-outline">
                Track Order
            </MudButton>
        </div>

        <ol class="home-steps">
            <li>Design</li>
            <li>Order</li>
            <li>Delivered</li>
        </ol>
    </div>

    <div class="home-stage">
        <div class="home-viewer">
            <ShirtViewerComponent @ref="_shirtViewer" OnModuleReady="OnShirtReady" ShowControls="false" />
        </div>

        <div class="home-stage-bar">
            <span class="home-swatch" style="background-color: @_currentColor;"></span>
            <span class="home-stage-label">Live Preview @_currentColor</span>
            <button type="button" class="home-stage-toggle" aria-pressed="@(_isPaused ? "true" : "false")" @onclick="TogglePlayback">
                @(_isPaused ? "Resume" : "Pause")
            </button>
        </div>
    </div>
</section>

@code {
    #region Properties
    private ShirtViewerComponent? _shirtViewer;
    private readonly CancellationTokenSource _cts = new();
    private readonly Random _random = new();
    private const string PageBackgroundColor = "#10121F";
    private string _currentColor = "#B4182D";
    private bool _isPaused;

    private static readonly string[] Prefixes = { "THE", "URBAN", "PROJECT", "NEO", "VINTAGE", "STUDIO", "RAW", "7G", "AURA", "STREET" };
    private static readonly string[] Suffixes = { "CULTURE", "SOCIETY", "WEAR", "COLLECTION", "EST 2026", "VISION", "THREADS", "MINDSET", "CORE" };
    private static readonly string[] Fonts = { "Outfit", "Arial", "Impact", "Courier New", "Georgia", "Verdana", "Trebuchet MS", "Tahoma" };
    #endregion

    #region Lifecycle
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
    #endregion

    #region Navigation
    private async Task<bool> IsSignedInAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated == true;
    }

    private async Task StartCustomizing()
    {
        NavManager.NavigateTo(await IsSignedInAsync() ? "/add-order" : "/login");
    }

    private async Task TrackOrder()
    {
        NavManager.NavigateTo(await IsSignedInAsync() ? "/dashboard" : "/login");
    }
    #endregion

    #region Shirt Preview
    private async Task OnShirtReady()
    {
        if (_shirtViewer == null) return;

        await _shirtViewer.SetBackgroundColorAsync(PageBackgroundColor);
        await _shirtViewer.SetAutoSpinAsync(true);
        _ = RunRandomizerLoopAsync();
    }

    private async Task TogglePlayback()
    {
        _isPaused = !_isPaused;

        if (_shirtViewer != null)
        {
            await _shirtViewer.SetAutoSpinAsync(!_isPaused);
        }
    }

    private async Task RunRandomizerLoopAsync()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested && _shirtViewer != null)
            {
                if (!_isPaused)
                {
                    await ApplyRandomDesignAsync();
                }

                await Task.Delay(_random.Next(1500, 3000), _cts.Token);
            }
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ApplyRandomDesignAsync()
    {
        int r = _random.Next(0, 256);
        int g = _random.Next(0, 256);
        int b = _random.Next(0, 256);
        double luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        string textColor = luminance > 0.5 ? "#111111" : "#FFFFFF";

        var batchConfig = new
        {
            color = $"#{r:X2}{g:X2}{b:X2}",
            items = BuildRandomItems(textColor)
        };

        await _shirtViewer!.ApplyDesignBatchAsync(batchConfig);

        _currentColor = batchConfig.color;
        await InvokeAsync(StateHasChanged);
    }

    private List<object> BuildRandomItems(string textColor)
    {
        var items = new List<object>();
        int itemCount = _random.Next(1, 4);

        for (int i = 0; i < itemCount; i++)
        {
            double angle = _random.NextDouble() * Math.PI * 2;
            float radius = 2.0f;
            float originX = (float)(Math.Cos(angle) * radius);
            float originZ = (float)(Math.Sin(angle) * radius);
            float originY = (float)(_random.NextDouble() * 0.7 - 0.2);

            items.Add(_random.NextDouble() < 0.7
                ? BuildTextItem(textColor, originX, originY, originZ)
                : BuildImageItem(textColor, originX, originY, originZ));
        }

        return items;
    }

    private object BuildTextItem(string textColor, float originX, float originY, float originZ)
    {
        string text = _random.Next(3) switch
        {
            0 => Prefixes[_random.Next(Prefixes.Length)],
            1 => Prefixes[_random.Next(Prefixes.Length)] + "\n" + Suffixes[_random.Next(Suffixes.Length)],
            _ => _random.Next(1000, 9999).ToString()
        };

        return new
        {
            type = "text",
            text,
            fontSize = _random.Next(35, 70),
            color = textColor,
            font = Fonts[_random.Next(Fonts.Length)],
            originX, originY, originZ,
            dirX = -originX, dirY = 0f, dirZ = -originZ
        };
    }

    private object BuildImageItem(string textColor, float originX, float originY, float originZ)
    {
        return new
        {
            type = "image",
            dataUrl = BuildRandomShapeDataUrl(textColor),
            size = (float)(_random.NextDouble() * 0.4 + 0.3),
            originX, originY, originZ,
            dirX = -originX, dirY = 0f, dirZ = -originZ
        };
    }

    private string BuildRandomShapeDataUrl(string color)
    {
        string svg = _random.Next(4) switch
        {
            0 => $"<svg width='200' height='200' xmlns='http://www.w3.org/2000/svg'><circle cx='100' cy='100' r='90' fill='{color}' /></svg>",
            1 => $"<svg width='200' height='200' xmlns='http://www.w3.org/2000/svg'><polygon points='100,10 190,190 10,190' fill='{color}' /></svg>",
            2 => $"<svg width='200' height='200' xmlns='http://www.w3.org/2000/svg'><rect x='75' y='10' width='50' height='180' fill='{color}' /><rect x='10' y='75' width='180' height='50' fill='{color}' /></svg>",
            _ => $"<svg width='200' height='200' xmlns='http://www.w3.org/2000/svg'><rect x='20' y='20' width='160' height='160' fill='none' stroke='{color}' stroke-width='20' /></svg>"
        };

        return "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
    }
    #endregion
}
