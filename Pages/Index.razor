@page "/"
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Home — 7 Guys House of Fashion</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="home-container">
    <MudGrid Class="hero-grid" Spacing="6" Justify="Justify.Center" AlignItems="AlignItems.Center">
        
        <!-- Left Column: Copy & CTA -->
        <MudItem xs="12" md="6" Class="hero-content">
            <MudText Typo="Typo.h1" Class="hero-headline" Style="font-family: 'Outfit', sans-serif; font-weight: 300; line-height: 1.1; letter-spacing: -0.02em;">
                Bespoke 3D<br/>Tailoring.
            </MudText>
            <MudText Typo="Typo.h6" Class="hero-subtext mt-4" Style="font-family: 'Outfit', sans-serif; font-weight: 300; color: var(--mud-palette-text-secondary); max-width: 450px;">
                Design your identity with precise control and real-time visualization.
            </MudText>
            
            <div class="hero-actions mt-8 d-flex flex-wrap gap-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="HandleAddOrder" Class="btn-primary-minimal">
                    Start Customizing
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" OnClick="HandleViewOrder" Class="btn-secondary-minimal">
                    Track Order
                </MudButton>
            </div>
        </MudItem>

        <!-- Right Column: Visual -->
        <MudItem xs="12" md="6" Class="hero-visual d-flex justify-center align-center">
            <div class="hero-3d-wrapper">
                <ShirtCanvasComponent @ref="_shirtCanvas" OnModuleReady="OnShirtReady" ShowControls="false" />
            </div>
            <!-- Hidden fabric canvas required by ShirtCanvasComponent initialization -->
            <canvas id="fabric-canvas" style="display:none;"></canvas>
        </MudItem>

    </MudGrid>
</MudContainer>

<style>
    .home-container {
        min-height: calc(100vh - 64px);
        display: flex;
        background-color: var(--mud-palette-background);
        padding: 4rem 2rem;
    }

    .hero-grid {
        width: 100%;
    }

    @@media (max-width: 900px) {
        .hero-content {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .hero-actions {
            justify-content: center;
        }
        
        .hero-subtext {
            margin: 0 auto;
        }
    }

    .btn-primary-minimal {
        padding: 0.75rem 2rem;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        border-radius: 4px;
    }

    .btn-secondary-minimal {
        padding: 0.75rem 2rem;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        border-color: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
    }

    .btn-secondary-minimal:hover {
        border-color: rgba(255, 255, 255, 0.6);
    }

    .hero-3d-wrapper {
        width: 100%;
        max-width: 600px;
        aspect-ratio: 1 / 1;
        position: relative;
    }

    /* Override the default container styles for a clean minimalist float */
    ::deep .three-canvas-container {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
    }
</style>

@code {
    private ShirtCanvasComponent? _shirtCanvas;
    private CancellationTokenSource _cts = new();
    
    private readonly string[] _colors = { "#B51A2B", "#541A2E", "#FFA586", "#161E2F", "#242E49", "#384358", "#FFFFFF", "#000000" };
    private readonly string[] _fonts = { "Outfit", "Arial", "Impact", "Courier New", "Georgia" };
    private readonly string[] _texts = { "BESPOKE", "7 GUYS", "STYLE", "3D", "CUSTOM", "FASHION", "MINIMAL" };

    private async Task OnShirtReady()
    {
        if (_shirtCanvas == null) return;
        
        // Enable Auto Spin to captivate attention
        await _shirtCanvas.SetAutoSpinAsync(true);
        
        // Start the background loop
        _ = RunRandomizerLoopAsync();
    }

    private async Task RunRandomizerLoopAsync()
    {
        var random = new Random();
        while (!_cts.Token.IsCancellationRequested)
        {
            if (_shirtCanvas == null) break;
            
            // Clear previous design
            await _shirtCanvas.ClearDesignAsync();

            // Pick a random background color
            var bgColor = _colors[random.Next(_colors.Length)];
            await _shirtCanvas.SetColorAsync(bgColor);
            
            // Add random text
            var text = _texts[random.Next(_texts.Length)];
            var font = _fonts[random.Next(_fonts.Length)];
            
            // Ensure contrast
            var textColor = (bgColor == "#FFFFFF" || bgColor == "#FFA586") ? "#161E2F" : "#FFFFFF"; 
            
            var fontSize = random.Next(40, 75);
            
            await _shirtCanvas.AddTextAsync(text, fontSize, textColor, font);
            
            try
            {
                // Wait 1.5 seconds before generating the next design
                await Task.Delay(1500, _cts.Token);
            }
            catch (TaskCanceledException)
            {
                break;
            }
        }
    }

    private async Task HandleAddOrder()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/add-order");
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    private async Task HandleViewOrder()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/dashboard");
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}
