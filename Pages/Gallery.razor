@page "/gallery"
@inject CapstoneProject.Services.SupabaseService SupabaseSvc

<PageTitle>Gallery — ThreadStudio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h3" Style="font-family:'Outfit',sans-serif; font-weight:700; color:white; margin-bottom: 2rem;">
        Design Gallery
    </MudText>

    @if (_loading)
    {
        <div style="display:flex; justify-content:center; padding: 4rem;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_designs.Count == 0)
    {
        <MudText Typo="Typo.h6" Style="color:#9998b3;">No designs found. Go create one!</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var design in _designs)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Style="background: rgba(19, 19, 31, 0.8); border: 1px solid rgba(124,58,237,0.15); border-radius: 12px; height: 100%;">
                        @if (!string.IsNullOrEmpty(design.texture_url))
                        {
                            <MudCardMedia Image="@design.texture_url" Height="250" />
                        }
                        else
                        {
                            <div style="height:250px; background-color:@design.shirt_color; display:flex; align-items:center; justify-content:center;">
                                <MudText Style="color:white; mix-blend-mode:difference;">No Preview</MudText>
                            </div>
                        }
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Style="font-family:'Outfit',sans-serif; font-weight:600; color:white;">
                                @(string.IsNullOrWhiteSpace(design.name) ? "Untitled Design" : design.name)
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color:#9998b3;">
                                @design.created_at.ToLocalTime().ToString("g")
                            </MudText>
                            @if (!string.IsNullOrEmpty(design.text_overlay))
                            {
                                <MudText Typo="Typo.caption" Style="color:#06b6d4; display:block; margin-top:0.5rem;">
                                    Text: "@design.text_overlay"
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<CapstoneProject.Services.SupabaseDesignDto> _designs = new();

    protected override async Task OnInitializedAsync()
    {
        _designs = await SupabaseSvc.GetDesignsAsync();
        _loading = false;
    }
}
