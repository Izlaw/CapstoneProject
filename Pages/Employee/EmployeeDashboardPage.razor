@page "/employee/dashboard"
@using Microsoft.AspNetCore.Authorization
@using CapstoneProject.Commons
@attribute [Authorize(Roles = "employee,admin")]
@inject CapstoneProject.Services.SupabaseService SupabaseSvc
@inject CapstoneProject.Services.OrderService OrderSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>Employee Dashboard - 7 Guys House of Fashion</PageTitle>

<div class="pa-8" style="background-color: var(--bg-base); min-height: calc(100vh - 64px);">
    <div class="page-back"><BackButtonComponent Href="/" Text="Back to Home" /></div>

    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: 600; color: var(--text-primary);">Order Management</MudText>

        <div class="d-flex" style="gap: 0.75rem;">
            <AuthorizeView Roles="admin" Context="adminContext">
                <Authorized>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Tune" Href="/admin/catalog">
                        Catalog Settings
                    </MudButton>
                </Authorized>
            </AuthorizeView>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadOrders">
                Refresh
            </MudButton>
        </div>
    </div>
    
    <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--bg-surface); border: 1px solid var(--border-color);">
        <MudTable Items="@_orders" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Style="background: transparent;" Loading="@_isLoading">
            <HeaderContent>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Order ID</MudText></MudTh>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Customer</MudText></MudTh>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Type</MudText></MudTh>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Date</MudText></MudTh>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Status</MudText></MudTh>
                <MudTh><MudText Style="color: var(--text-secondary); font-weight: 500;">Total</MudText></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order ID">#@ShortId(context.Id)</MudTd>
                <MudTd DataLabel="Customer">@GetCustomerName(context.CustomerId)</MudTd>
                <MudTd DataLabel="Type">
                    @if (context.OrderType == "custom")
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">Custom</MudChip>
                    }
                    else if (context.OrderType == "collection")
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Text">Collection</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">Uploaded</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Date">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                <MudTd DataLabel="Status">
                    <MudSelect T="string" Value="@context.Status" ValueChanged="@(async (string s) => await UpdateStatus(context, s))" Disabled="@IsStatusLocked(context)" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width: 140px; background-color: var(--bg-base);">
                        @foreach (var status in GetStatusOptions(context))
                        {
                            <MudSelectItem Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Total">₱@context.TotalPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="Action">
                    <MudButton Href="@($"/order-preview/{context.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility">Details</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No orders found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private List<CapstoneProject.Models.AppOrderModel> _orders = new();
    private Dictionary<string, string> _customerNames = new();
    private bool _isLoading = true;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("admin");

        await LoadOrders();
    }

    private IEnumerable<string> GetStatusOptions(CapstoneProject.Models.AppOrderModel order)
    {
        return CapstoneProject.Models.OrderStatuses.All
            .Where(status => status != CapstoneProject.Models.OrderStatuses.Cancelled || _isAdmin || order.Status == status);
    }

    private bool IsStatusLocked(CapstoneProject.Models.AppOrderModel order)
    {
        return order.Status == CapstoneProject.Models.OrderStatuses.Cancelled && !_isAdmin;
    }

    private async Task LoadOrders()
    {
        _isLoading = true;
        try
        {
            _orders = await SupabaseSvc.GetAllOrdersAsync();
            _customerNames = await SupabaseSvc.GetCustomerNamesAsync(_orders.Select(x => x.CustomerId));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetCustomerName(string customerId)
    {
        return _customerNames.TryGetValue(customerId, out var name) ? name : "-";
    }

    private static string ShortId(string id)
    {
        return id.Length <= 8 ? id : id[..8];
    }

    private async Task UpdateStatus(CapstoneProject.Models.AppOrderModel order, string newStatus)
    {
        var previousStatus = order.Status;
        order.Status = newStatus;

        var result = await OrderSvc.UpdateOrderStatusAsync(order.Id, newStatus);
        if (result.IsSuccess)
        {
            Extension.ShowAlert($"Order #{ShortId(order.Id)} status updated to {newStatus}", Variant.Filled, Snackbar, Severity.Success);
        }
        else
        {
            order.Status = previousStatus;
            Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
        }
    }
}
