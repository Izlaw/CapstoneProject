@page "/order-preview/{Id}"
@using Microsoft.AspNetCore.Authorization
@using CapstoneProject.Commons
@attribute [Authorize]
@inject SupabaseService SupabaseSvc
@inject OrderService OrderSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavManager

<PageTitle>Order Receipt - 7 Guys House of Fashion</PageTitle>

<div class="customer-page">
    <div class="page-back"><BackButtonComponent Href="@_parentHref" Text="@($"Back to {_parentText}")" /></div>

    @if (Placed && _order != null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
            Your order has been placed. We will review it and keep this page updated.
        </MudAlert>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_order == null)
    {
        <div class="customer-empty">
            <h1 class="customer-title">Order Not Found</h1>
            <p>@(_loadMessage ?? "This order does not exist, or you do not have access to it.")</p>
            <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">
                Back to My Orders
            </MudButton>
        </div>
    }
    else
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" md="7">
                <div class="receipt-panel">
                    <div class="receipt-header">
                        <div>
                            <h1 class="receipt-title">Order Receipt</h1>
                            <p class="receipt-id">Order #@_order.Id.Substring(0, 8)</p>
                        </div>
                        <div class="d-flex align-center" style="gap: 0.75rem;">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.QrCode2" OnClick="ShowShareQr">
                                Share QR
                            </MudButton>
                            <MudChip T="string" Color="@GetStatusColor(_order.Status)" Variant="Variant.Filled" Size="Size.Small">@_order.Status</MudChip>
                        </div>
                    </div>

                    @if (_order.CustomOrder != null)
                    {
                        <div class="receipt-3d">
                            <ShirtViewerComponent @ref="_shirtViewer" OnModuleReady="ShowDesignIn3D" ShowControls="true" />
                        </div>
                        <p class="receipt-3d-hint">Drag to rotate the shirt and scroll to zoom.</p>
                    }
                    else if (!string.IsNullOrEmpty(_imageUrl))
                    {
                        <div class="receipt-image-frame">
                            <img src="@_imageUrl" alt="Uploaded design" class="receipt-image" />
                        </div>
                    }

                    <div class="receipt-details">
                        <div>
                            <span class="receipt-label">Date</span>
                            <span class="receipt-value">@_order.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        </div>
                        <div>
                            <span class="receipt-label">Order Type</span>
                            <span class="receipt-value">@GetOrderTypeText(_order.OrderType)</span>
                        </div>
                        <div>
                            <span class="receipt-label">Delivery</span>
                            <span class="receipt-value">@(_order.TimeframeLabel ?? "-")</span>
                        </div>
                        @if (_order.CustomOrder != null)
                        {
                            <div>
                                <span class="receipt-label">Fabric</span>
                                <span class="receipt-value">@GetFabricText(_order.CustomOrder.FabricName, _order.CustomOrder.FabricNote)</span>
                            </div>
                            @foreach (var row in _order.CustomOrder.DesignData.GetColorRows(_order.CustomOrder.ShirtColor))
                            {
                                <div>
                                    <span class="receipt-label">@row.Label</span>
                                    <span class="receipt-value">
                                        <span class="receipt-swatch" style="background-color: @row.Color;"></span>
                                        @row.Color.ToUpper()
                                    </span>
                                </div>
                            }
                        }
                        @if (_order.UploadOrder != null)
                        {
                            <div>
                                <span class="receipt-label">Fabric</span>
                                <span class="receipt-value">@GetFabricText(_order.UploadOrder.FabricName, _order.UploadOrder.FabricNote)</span>
                            </div>
                            <div>
                                <span class="receipt-label">File</span>
                                <span class="receipt-value">@(_order.UploadOrder.OriginalFileName ?? "-")</span>
                            </div>
                        }
                        @if (_order.CollectionOrder != null)
                        {
                            <div>
                                <span class="receipt-label">Design</span>
                                <span class="receipt-value">@_order.CollectionOrder.CollectionName</span>
                            </div>
                        }
                    </div>

                    <table class="receipt-table">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th class="receipt-num">Quantity</th>
                                <th class="receipt-num">Price Each</th>
                                <th class="receipt-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _order.Items.OrderBy(item => item.SizeName))
                            {
                                <tr>
                                    <td>@item.SizeName</td>
                                    <td class="receipt-num">@item.Quantity</td>
                                    <td class="receipt-num">₱@item.UnitPrice.ToString("N2")</td>
                                    <td class="receipt-num">₱@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="receipt-totals">
                        <div class="receipt-total-row">
                            <span>Subtotal (@_order.Quantity pieces)</span>
                            <span>₱@((_order.Subtotal ?? _order.TotalPrice).ToString("N2"))</span>
                        </div>
                        @if ((_order.SurchargePercent ?? 0) > 0)
                        {
                            <div class="receipt-total-row">
                                <span>Delivery Extra (@_order.SurchargePercent?.ToString("0.##")%)</span>
                                <span>₱@((_order.SurchargeAmount ?? 0).ToString("N2"))</span>
                            </div>
                        }
                        <div class="receipt-total-row receipt-grand-total">
                            <span>Total</span>
                            <span>₱@_order.TotalPrice.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" md="5">
                <div class="receipt-panel receipt-chat">
                    <div class="mb-4">
                        <h2 class="receipt-chat-title">Order Support</h2>
                        <p class="receipt-chat-subtitle">Message us about any changes to your order.</p>
                    </div>

                    <MudDivider Class="mb-4" />

                    <div class="flex-grow-1 overflow-y-auto mb-4" style="background-color: var(--bg-base); border-radius: 8px; padding: 16px;">
                        @if (_messages == null)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                        }
                        else if (!_messages.Any())
                        {
                            <MudText Typo="Typo.body2" Style="color: var(--text-secondary); text-align: center;">No messages yet. Send a message to start chatting with support.</MudText>
                        }
                        else
                        {
                            foreach (var msg in _messages)
                            {
                                bool isMyMessage = msg.SenderId == _currentUserId;
                                string msgStyle = (isMyMessage ? "background-color: var(--primary); color: white; border-radius: 8px 8px 0 8px;" : "background-color: var(--bg-elevated); color: var(--text-primary); border-radius: 8px 8px 8px 0;") + " max-width: 85%;";
                                string timeStyle = (isMyMessage ? "color: #e0e0e0;" : "color: var(--text-muted);") + " display: block; text-align: right; margin-top: 4px;";

                                <div class="d-flex mb-4" style="justify-content: @(isMyMessage ? "flex-end" : "flex-start")">
                                    <MudPaper Elevation="0" Class="pa-3" Style="@msgStyle">
                                        <MudText Typo="Typo.body2">@msg.Content</MudText>
                                        <MudText Typo="Typo.caption" Style="@timeStyle">
                                            @(isMyMessage ? "You" : "Support") • @msg.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                        </MudText>
                                    </MudPaper>
                                </div>
                            }
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <MudTextField @bind-Value="_newMessage" Placeholder="Type a message..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" OnKeyUp="SendOnEnter" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="SendMessage" Disabled="@(string.IsNullOrWhiteSpace(_newMessage) || _isSending)">
                            Send
                        </MudButton>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    #region Properties
    [Parameter] public string Id { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public bool Placed { get; set; }

    private const string ViewerBackgroundColor = "#0E0F13";

    private AppOrderModel? _order;
    private ShirtViewerComponent? _shirtViewer;
    private string _parentHref = "/dashboard";
    private string _parentText = "My Orders";
    private string? _imageUrl;
    private string? _loadMessage;
    private List<ChatMessageModel>? _messages;
    private string? _conversationId;
    private string? _currentUserId;
    private string _newMessage = string.Empty;
    private bool _isLoading = true;
    private bool _isSending;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (authState.User.IsInRole("employee") || authState.User.IsInRole("admin"))
            {
                _parentHref = "/employee/dashboard";
                _parentText = "Orders";
            }

            var result = await OrderSvc.GetOrderDetailsAsync(Id);
            if (!result.IsSuccess)
            {
                _loadMessage = result.Message;
                return;
            }

            _order = result.Value;
            _imageUrl = await OrderSvc.GetImageUrlAsync(_order?.UploadOrder?.UploadedImagePath);
            await LoadConversation();
        }
        finally
        {
            _isLoading = false;
        }
    }
    #endregion

    #region Methods
    private async Task ShowDesignIn3D()
    {
        if (_shirtViewer == null || _order?.CustomOrder == null) return;

        try
        {
            await _shirtViewer.SetBackgroundColorAsync(ViewerBackgroundColor);

            var items = new List<object>();
            foreach (var element in _order.CustomOrder.DesignData.Elements)
            {
                var item = await BuildViewerItem(element);
                if (item != null)
                {
                    items.Add(item);
                }
            }

            await _shirtViewer.ApplyDesignBatchAsync(new { color = _order.CustomOrder.ShirtColor, parts = _order.CustomOrder.DesignData.Parts, items });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task<object?> BuildViewerItem(DesignElementModel element)
    {
        string? imageUrl = null;

        if (element.Type == "image")
        {
            imageUrl = await OrderSvc.GetImageUrlAsync(element.Path);
            if (imageUrl == null) return null;
        }

        return new
        {
            type = element.Type,
            text = element.Text,
            fontSize = element.FontSize,
            color = element.Color,
            font = element.Font,
            size = element.Size,
            originX = element.OriginX,
            originY = element.OriginY,
            originZ = element.OriginZ,
            dirX = element.DirX,
            dirY = element.DirY,
            dirZ = element.DirZ,
            dataUrl = imageUrl
        };
    }

    private async Task ShowShareQr()
    {
        if (_order == null || string.IsNullOrEmpty(_order.ShareToken)) return;

        var parameters = new DialogParameters<OrderSuccessDialog>
        {
            { x => x.OrderId, _order.Id },
            { x => x.PreviewUrl, NavManager.ToAbsoluteUri($"/shared/{_order.ShareToken}").ToString() },
            { x => x.HeaderText, "Share This Order" },
            { x => x.MessageText, "Anyone who scans this QR code can view this order's design and price without signing in." },
            { x => x.CloseText, "Close" },
            { x => x.ShowSuccessIcon, false }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };

        await DialogService.ShowAsync<OrderSuccessDialog>("Share order", parameters, options);
    }

    private async Task LoadConversation()
    {
        if (_order == null || string.IsNullOrEmpty(_order.CustomerId)) return;

        _conversationId = await SupabaseSvc.GetOrCreateConversationAsync(_order.CustomerId);
        if (!string.IsNullOrEmpty(_conversationId))
        {
            _messages = await SupabaseSvc.GetMessagesAsync(_conversationId);
        }
    }

    private static string GetOrderTypeText(string orderType)
    {
        return orderType switch
        {
            "custom" => "Custom Design",
            "collection" => "Collection Design",
            "upload" => "Uploaded Design",
            _ => "-"
        };
    }

    private static string GetFabricText(string fabricName, string? fabricNote)
    {
        return string.IsNullOrWhiteSpace(fabricNote) ? fabricName : $"{fabricName} ({fabricNote})";
    }

    private static Color GetStatusColor(string? status)
    {
        return status switch
        {
            "Pending" => Color.Warning,
            "In Progress" => Color.Info,
            "Ready for Pickup" => Color.Primary,
            "Completed" => Color.Success,
            "Cancelled" => Color.Error,
            _ => Color.Default
        };
    }

    private async Task SendOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (_isSending || string.IsNullOrWhiteSpace(_newMessage) || string.IsNullOrEmpty(_conversationId) || string.IsNullOrEmpty(_currentUserId)) return;

        _isSending = true;
        var messageText = _newMessage;
        _newMessage = string.Empty;

        try
        {
            var success = await SupabaseSvc.SendMessageAsync(_conversationId, messageText);
            if (success)
            {
                _messages = await SupabaseSvc.GetMessagesAsync(_conversationId);
            }
            else
            {
                _newMessage = messageText;
                Extension.ShowAlert("Failed to send message. Please try again.", Variant.Filled, Snackbar, Severity.Error);
            }
        }
        finally
        {
            _isSending = false;
        }
    }
    #endregion
}
