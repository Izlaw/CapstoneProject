@page "/add-order"

<PageTitle>New Order - 7 Guys House of Fashion</PageTitle>

<div class="customer-page">
    <div class="page-back"><BackButtonComponent Href="/" Text="Back to Home" /></div>

    <div class="customer-header">
        <h1 class="customer-title">New Order</h1>
        <p class="customer-subtitle">Choose how you want to start.</p>
    </div>

    <div class="order-choices">
        <a href="/designer" class="order-choice">
            <span class="order-choice-icon order-choice-primary">
                <MudIcon Icon="@Icons.Material.Filled.Brush" />
            </span>
            <span class="order-choice-title">Custom Design</span>
            <span class="order-choice-text">Build your own shirt in the 3D designer. Pick colors, add text and your logo.</span>
            <span class="order-choice-go">Open the Designer</span>
        </a>

        <a href="/collections" class="order-choice">
            <span class="order-choice-icon order-choice-accent">
                <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" />
            </span>
            <span class="order-choice-title">From Collections</span>
            <span class="order-choice-text">Choose a ready-made design from our shop and just set your sizes and quantity.</span>
            <span class="order-choice-go">Browse Collections</span>
        </a>

        <a href="/upload-order" class="order-choice">
            <span class="order-choice-icon order-choice-info">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" />
            </span>
            <span class="order-choice-title">Upload Your Design</span>
            <span class="order-choice-text">Already have artwork? Upload it and we will print it on the fabric you choose.</span>
            <span class="order-choice-go">Upload a File</span>
        </a>
    </div>
</div>
