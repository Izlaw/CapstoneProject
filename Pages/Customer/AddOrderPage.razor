@page "/add-order"
@inject NavigationManager NavManager

<PageTitle>Add Order — 7 Guys House of Fashion</PageTitle>

<div class="add-order-container">
    <div class="action-cards-wrapper">
        
        <!-- Add Custom Order Card -->
        <div class="action-card" @onclick="HandleCustomOrder">
            <div class="card-bg-image" style="background-image: url('/images/hero_shirt.png'); filter: brightness(0.9);"></div>
            <div class="card-overlay"></div>
            <div class="card-content">
                <div class="icon-circle">
                    <MudIcon Icon="@Icons.Material.Filled.FileUpload" Size="Size.Large" />
                </div>
                <h2 class="card-title">Add Custom Order</h2>
            </div>
        </div>

        <!-- View Existing Design / Collections Card -->
        <div class="action-card" @onclick="HandleViewCollections">
            <div class="card-bg-image" style="background-image: url('/images/hero_shirt.png'); filter: grayscale(80%) brightness(0.7);"></div>
            <div class="card-overlay"></div>
            <div class="card-content">
                <div class="icon-circle">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" />
                </div>
                <h2 class="card-title">View Collections</h2>
            </div>
        </div>

    </div>
</div>

<style>
    .add-order-container {
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-base);
        padding: 2rem;
    }

    .action-cards-wrapper {
        display: flex;
        gap: 3rem;
        max-width: 1000px;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-card {
        position: relative;
        width: 320px;
        height: 480px;
        border-radius: 24px;
        overflow: hidden;
        cursor: pointer;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .action-card:hover {
        transform: translateY(-10px);
        border-color: var(--accent);
        box-shadow: 0 20px 40px rgba(180, 24, 45, 0.3);
    }

    .card-bg-image {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform 0.6s ease;
    }

    .action-card:hover .card-bg-image {
        transform: scale(1.08);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(16, 18, 31, 0.3), rgba(16, 18, 31, 0.95));
    }

    .card-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        z-index: 1;
        text-align: center;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        transition: all 0.3s ease;
    }

    .action-card:hover .icon-circle {
        background: var(--primary);
        border-color: var(--primary);
        transform: scale(1.1);
    }

    .card-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.6rem;
        letter-spacing: 0.05em;
        color: white;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        text-transform: uppercase;
        padding: 0 1rem;
    }
</style>

@code {
    private void HandleCustomOrder()
    {
        NavManager.NavigateTo("/designer");
    }

    private void HandleViewCollections()
    {
        NavManager.NavigateTo("/gallery");
    }
}
