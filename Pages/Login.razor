@page "/login"
@inject CapstoneProject.Services.SupabaseService SupabaseSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Login — ThreadStudio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 mb-16">
    <MudCard Style="background: rgba(19, 19, 31, 0.8); border: 1px solid rgba(124,58,237,0.15); border-radius: 12px; padding: 2rem;">
        <MudText Typo="Typo.h4" Style="font-family:'Outfit',sans-serif; font-weight:700; color:white; text-align:center; margin-bottom: 2rem;">
            @(_isRegistering ? "Create Account" : "Welcome Back")
        </MudText>

        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-6" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="HandleSubmit" Disabled="@_isLoading"
                   Style="border-radius:8px; font-family:'Outfit',sans-serif; font-weight:700; letter-spacing:0.05em; margin-bottom:1rem;">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Please wait...</span>
            }
            else
            {
                <span>@(_isRegistering ? "Sign Up" : "Log In")</span>
            }
        </MudButton>

        <div style="text-align:center;">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ToggleMode"
                       Style="font-family:'Outfit',sans-serif; font-size:0.85rem;">
                @(_isRegistering ? "Already have an account? Log In" : "Don't have an account? Sign Up")
            </MudButton>
        </div>
    </MudCard>
</MudContainer>

@code {
    private string _email = "";
    private string _password = "";
    private bool _isRegistering = false;
    private bool _isLoading = false;

    private void ToggleMode()
    {
        _isRegistering = !_isRegistering;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Please enter email and password.", Severity.Warning);
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            if (_isRegistering)
            {
                var response = await SupabaseSvc.RegisterAsync(_email, _password);
                if (response?.access_token != null)
                {
                    await ((CapstoneProject.Services.SupabaseAuthStateProvider)AuthStateProvider).LoginAsync(response.access_token);
                    Snackbar.Add("Account created successfully!", Severity.Success);
                    NavManager.NavigateTo("/");
                }
                else
                {
                    Snackbar.Add("Sign up failed. Please check your details.", Severity.Error);
                }
            }
            else
            {
                var response = await SupabaseSvc.LoginAsync(_email, _password);
                if (response?.access_token != null)
                {
                    await ((CapstoneProject.Services.SupabaseAuthStateProvider)AuthStateProvider).LoginAsync(response.access_token);
                    Snackbar.Add("Logged in successfully!", Severity.Success);
                    NavManager.NavigateTo("/");
                }
                else
                {
                    Snackbar.Add("Invalid login credentials.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
