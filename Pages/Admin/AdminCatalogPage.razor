@page "/admin/catalog"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]

<PageTitle>Catalog Settings - 7 Guys House of Fashion</PageTitle>

<div class="admin-page">
    <div class="page-back"><BackButtonComponent Href="/" Text="Back to Home" /></div>

    <div class="admin-header">
        <h1 class="admin-title">Catalog Settings</h1>
        <p class="admin-subtitle">Manage the sizes, fabrics, delivery options and designs customers can order, and what they cost.</p>
    </div>

    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="admin-note">
        How prices work: each piece costs its size price plus its fabric price (or its design price for ready-made designs).
        A delivery option then adds its extra charge, as a percentage, on top of the order subtotal.
        Changing a price only affects new orders. Existing orders keep the prices they were placed with.
    </MudAlert>

    <MudTabs Elevation="0" Rounded="false" Class="admin-tabs" PanelClass="admin-tab-panel">
        <MudTabPanel Text="Sizes">
            <CatalogSizesTab />
        </MudTabPanel>
        <MudTabPanel Text="Fabrics">
            <CatalogFabricsTab />
        </MudTabPanel>
        <MudTabPanel Text="Delivery Options">
            <CatalogTimeframesTab />
        </MudTabPanel>
        <MudTabPanel Text="Designs">
            <CatalogCollectionsTab />
        </MudTabPanel>
        <MudTabPanel Text="Price History">
            <CatalogPriceHistoryTab />
        </MudTabPanel>
    </MudTabs>
</div>
