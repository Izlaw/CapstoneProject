@page "/admin/catalog"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]

<PageTitle>Catalog Settings - 7 Guys House of Fashion</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <h1 class="admin-title">Catalog Settings</h1>
        <p class="admin-subtitle">Manage the sizes, fabrics, timeframes and collections customers can order, and what they cost.</p>
    </div>

    <MudTabs Elevation="0" Rounded="false" Class="admin-tabs" PanelClass="admin-tab-panel">
        <MudTabPanel Text="Sizes">
            <CatalogSizesTab />
        </MudTabPanel>
        <MudTabPanel Text="Fabrics">
            <CatalogFabricsTab />
        </MudTabPanel>
        <MudTabPanel Text="Timeframes">
            <CatalogTimeframesTab />
        </MudTabPanel>
        <MudTabPanel Text="Collections">
            <CatalogCollectionsTab />
        </MudTabPanel>
        <MudTabPanel Text="Submissions">
            <CatalogSubmissionsTab />
        </MudTabPanel>
        <MudTabPanel Text="Price History">
            <CatalogPriceHistoryTab />
        </MudTabPanel>
    </MudTabs>
</div>
