@page "/register"
@using CapstoneProject.Commons
@inject CapstoneProject.Services.SupabaseService SupabaseSvc
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Register - 7 Guys House of Fashion</PageTitle>

<div class="auth-page">
    <div class="auth-back auth-back-wide"><BackButtonComponent Href="/" Text="Back to Home" /></div>
    <MudPaper Class="auth-card auth-card-wide" Elevation="0">
        <span class="auth-brand">7 Guys <span class="brand-accent">House of Fashion</span></span>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Style="color: var(--text-secondary);">Create an account to start ordering.</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FirstName" Label="First Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="LastName" Label="Last Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Email" Label="Email Address" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Contact" Label="Contact Number" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="ConfirmPassword" Label="Confirm Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isLoading" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Address" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Disabled="@_isLoading" />
            </MudItem>
        </MudGrid>
        
        <div class="d-flex justify-center gap-4 mt-8">
            <MudButton OnClick="HandleRegister" Disabled="@_isLoading" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="border-radius: 100px; padding: 0.5rem 2rem;">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Registering</MudText>
                }
                else
                {
                    <MudText>Register</MudText>
                }
            </MudButton>
            <MudButton Disabled="@_isLoading" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large" Style="border-radius: 100px; padding: 0.5rem 2rem;" Href="@LoginHref">Already registered?</MudButton>
        </div>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    public string FirstName { get; set; } = "";
    public string LastName { get; set; } = "";
    public string Email { get; set; } = "";
    public string Contact { get; set; } = "";
    public string Password { get; set; } = "";
    public string ConfirmPassword { get; set; } = "";
    public string Address { get; set; } = "";
    
    private bool _isLoading = false;

    private string LoginHref => Extension.IsLocalUrl(ReturnUrl)
        ? $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "/login";

    private static string? ToNullIfEmpty(string value)
    {
        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    private async Task HandleRegister()
    {
        if (_isLoading) return;

        if (Password != ConfirmPassword)
        {
            Extension.ShowAlert("Passwords do not match.", Variant.Filled, Snackbar, Severity.Error);
            return;
        }

        _isLoading = true;

        try
        {
            var fullName = $"{FirstName} {LastName}".Trim();
            var session = await SupabaseSvc.RegisterAsync(Email, Password, fullName);

            if (session != null && session.User != null)
            {
                var profileResult = await SupabaseSvc.UpdateProfileAsync(session.User.Id!, fullName, ToNullIfEmpty(Contact), ToNullIfEmpty(Address));
                if (!profileResult.IsSuccess)
                {
                    Console.WriteLine(profileResult.Message);
                }

                NavManager.NavigateTo(Extension.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/dashboard", forceLoad: true);
            }
            else
            {
                Extension.ShowAlert("Registration failed. Please check your details.", Variant.Filled, Snackbar, Severity.Error);
            }
        }
        catch (Exception)
        {
            Extension.ShowAlert("Registration failed. Please check your details.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
