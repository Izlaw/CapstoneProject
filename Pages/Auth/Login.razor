@page "/login"
@inject CapstoneProject.Services.SupabaseService SupabaseSvc
@inject NavigationManager NavManager

<PageTitle>Login - 7Guys House of Fashion</PageTitle>

<div style="height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-base);">
    <MudPaper Class="pa-8" Elevation="4" Style="width: 100%; max-width: 400px; border-radius: 12px; background-color: var(--bg-surface);">
        <div class="d-flex justify-center mb-6">
            <h2 class="nav-brand">THREAD<span class="brand-accent">STUDIO</span></h2>
        </div>
        
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="Email" Label="Email" Variant="Variant.Outlined" Class="mb-4" Disabled="@_isLoading" />
        <MudTextField @bind-Value="Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-6" Disabled="@_isLoading" />
        
        <MudButton OnClick="HandleLogin" Disabled="@_isLoading" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mb-4" Style="border-radius: 100px;">
            @if (_isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Logging in</MudText>
            }
            else
            {
                <MudText>Log in</MudText>
            }
        </MudButton>
        
        <div class="d-flex justify-center mt-4">
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Don't have an account? <MudLink Href="/register" Color="Color.Primary">Sign up!</MudLink>
            </MudText>
        </div>
    </MudPaper>
</div>

@code {
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    
    private bool _isLoading = false;
    private string _errorMessage = "";

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = "";

        try
        {
            var session = await SupabaseSvc.LoginAsync(Email, Password);
            if (session != null && session.User != null)
            {
                // Fetch profile to check role for RBAC
                var profile = await SupabaseSvc.GetUserProfileAsync(session.User.Id);
                
                if (profile != null && (profile.Role == "employee" || profile.Role == "admin"))
                {
                    NavManager.NavigateTo("/employee/dashboard");
                }
                else
                {
                    NavManager.NavigateTo("/dashboard");
                }
            }
            else
            {
                _errorMessage = "Invalid login credentials.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
