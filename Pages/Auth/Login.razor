@page "/login"
@using CapstoneProject.Commons
@inject CapstoneProject.Services.SupabaseService SupabaseSvc
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Login - 7 Guys House of Fashion</PageTitle>

<div class="auth-page">
    <div class="auth-back auth-back-narrow"><BackButtonComponent Href="/" Text="Back to Home" /></div>
    <MudPaper Class="auth-card auth-card-narrow" Elevation="0">
        <span class="auth-brand">7 Guys <span class="brand-accent">House of Fashion</span></span>

        <MudTextField @bind-Value="Email" Label="Email" Variant="Variant.Outlined" Class="mb-4" Disabled="@_isLoading" />
        <MudTextField @bind-Value="Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-6" Disabled="@_isLoading" />
        
        <MudButton OnClick="HandleLogin" Disabled="@_isLoading" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mb-4" Style="border-radius: 100px;">
            @if (_isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Logging in</MudText>
            }
            else
            {
                <MudText>Log in</MudText>
            }
        </MudButton>
        
        <div class="d-flex justify-center mt-4">
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                Don't have an account? <MudLink Href="/register" Color="Color.Secondary">Sign up!</MudLink>
            </MudText>
        </div>
    </MudPaper>
</div>

@code {
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    
    private bool _isLoading = false;

    private async Task HandleLogin()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var session = await SupabaseSvc.LoginAsync(Email, Password);
            if (session != null && session.User != null)
            {
                // Fetch profile to check role for RBAC
                var profile = await SupabaseSvc.GetUserProfileAsync(session.User.Id);

                if (profile != null && (profile.Role == "employee" || profile.Role == "admin"))
                {
                    NavManager.NavigateTo("/employee/dashboard");
                }
                else
                {
                    NavManager.NavigateTo("/dashboard");
                }
            }
            else
            {
                Extension.ShowAlert("Invalid email or password.", Variant.Filled, Snackbar, Severity.Error);
            }
        }
        catch (Exception)
        {
            Extension.ShowAlert("Invalid email or password.", Variant.Filled, Snackbar, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
