@page "/shared/{Token:guid}"
@using CapstoneProject.Commons
@inject OrderService OrderSvc
@inject CatalogService CatalogSvc

<PageTitle>Shared Order - 7 Guys House of Fashion</PageTitle>

<div class="customer-page">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_order == null)
    {
        <div class="customer-empty">
            <h1 class="customer-title">Order Not Found</h1>
            <p>@_loadMessage</p>
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">
                Go to Home
            </MudButton>
        </div>
    }
    else
    {
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="8">
                <div class="receipt-panel">
                    <div class="receipt-header">
                        <div>
                            <h1 class="receipt-title">Order Details</h1>
                            <p class="receipt-id">Order #@_order.ShortId</p>
                        </div>
                        <MudChip T="string" Color="@GetStatusColor(_order.Status)" Variant="Variant.Filled" Size="Size.Small">@_order.Status</MudChip>
                    </div>

                    @if (HasDesignIn3D)
                    {
                        <div class="receipt-3d">
                            <ShirtViewerComponent @ref="_shirtViewer" OnModuleReady="ShowDesignIn3D" ShowControls="true" />
                        </div>
                        <p class="receipt-3d-hint">Drag to rotate the shirt and scroll to zoom.</p>
                    }
                    else if (!string.IsNullOrEmpty(_order.Upload?.ImageUrl))
                    {
                        <div class="receipt-image-frame">
                            <img src="@_order.Upload.ImageUrl" alt="Uploaded design" class="receipt-image" />
                        </div>
                    }

                    <div class="receipt-details">
                        <div>
                            <span class="receipt-label">Date</span>
                            <span class="receipt-value">@Extension.ToDisplayTime(_order.CreatedAt).ToString("MMM dd, yyyy")</span>
                        </div>
                        <div>
                            <span class="receipt-label">Order Type</span>
                            <span class="receipt-value">@OrderDisplay.GetOrderTypeText(_order.OrderType)</span>
                        </div>
                        <div>
                            <span class="receipt-label">Timeframe</span>
                            <span class="receipt-value">@(_order.TimeframeLabel ?? "-")</span>
                        </div>
                        @if (_order.Custom != null)
                        {
                            <div>
                                <span class="receipt-label">Fabric</span>
                                <span class="receipt-value">@OrderDisplay.GetFabricText(_order.Custom.FabricName, _order.Custom.FabricNote)</span>
                            </div>
                            @foreach (var row in _order.Custom.DesignData.GetColorRows(_order.Custom.ShirtColor))
                            {
                                <div>
                                    <span class="receipt-label">@row.Label</span>
                                    <span class="receipt-value">
                                        <span class="receipt-swatch" style="background-color: @row.Color;"></span>
                                        @row.Color.ToUpper()
                                    </span>
                                </div>
                            }
                        }
                        @if (_order.Upload != null)
                        {
                            <div>
                                <span class="receipt-label">Fabric</span>
                                <span class="receipt-value">@OrderDisplay.GetFabricText(_order.Upload.FabricName, _order.Upload.FabricNote)</span>
                            </div>
                        }
                        @if (_order.Collection != null)
                        {
                            <div>
                                <span class="receipt-label">Design</span>
                                <span class="receipt-value">@_order.Collection.CollectionName</span>
                            </div>
                        }
                    </div>

                    <table class="receipt-table">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th class="receipt-num">Quantity</th>
                                <th class="receipt-num">Price Each</th>
                                <th class="receipt-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _order.Items)
                            {
                                <tr>
                                    <td>@item.SizeName</td>
                                    <td class="receipt-num">@item.Quantity</td>
                                    <td class="receipt-num">₱@item.UnitPrice.ToString("N2")</td>
                                    <td class="receipt-num">₱@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="receipt-totals">
                        <div class="receipt-total-row">
                            <span>Subtotal (@OrderDisplay.GetPieceCountText(_order.Quantity))</span>
                            <span>₱@((_order.Subtotal ?? _order.TotalPrice).ToString("N2"))</span>
                        </div>
                        @if ((_order.SurchargePercent ?? 0) > 0)
                        {
                            <div class="receipt-total-row">
                                <span>Timeframe Fee (@_order.SurchargePercent?.ToString("0.##")%)</span>
                                <span>₱@((_order.SurchargeAmount ?? 0).ToString("N2"))</span>
                            </div>
                        }
                        <div class="receipt-total-row receipt-grand-total">
                            <span>Total</span>
                            <span>₱@_order.TotalPrice.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    #region Properties
    [Parameter] public Guid Token { get; set; }

    private const string ViewerBackgroundColor = "#0E0F13";

    private SharedOrderModel? _order;
    private ShirtViewerComponent? _shirtViewer;
    private string? _loadMessage;
    private bool _isLoading = true;

    private bool HasDesignIn3D => _order?.Custom != null || _order?.Collection?.DesignData?.Parts != null;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            var result = await OrderSvc.GetSharedOrderAsync(Token);
            if (!result.IsSuccess)
            {
                _loadMessage = result.Message;
                return;
            }

            _order = result.Value;
        }
        finally
        {
            _isLoading = false;
        }
    }
    #endregion

    #region Methods
    private async Task ShowDesignIn3D()
    {
        if (_shirtViewer == null || _order == null) return;

        try
        {
            await _shirtViewer.SetBackgroundColorAsync(ViewerBackgroundColor);

            if (_order.Custom != null)
            {
                await ShowCustomDesign(_order.Custom);
            }
            else if (_order.Collection?.DesignData != null)
            {
                await ShowCollectionDesign(_order.Collection.DesignData);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ShowCustomDesign(SharedCustomOrderModel customOrder)
    {
        if (_shirtViewer == null) return;

        var items = customOrder.DesignData.Elements
            .Where(element => element.Type != "image" || !string.IsNullOrEmpty(element.DataUrl))
            .Select(BuildViewerItem)
            .ToList();

        await _shirtViewer.ApplyDesignBatchAsync(new { color = customOrder.ShirtColor, parts = customOrder.DesignData.Parts, items });
    }

    private async Task ShowCollectionDesign(DesignDataModel designData)
    {
        if (_shirtViewer == null) return;

        var items = new List<object>();
        foreach (var element in designData.Elements)
        {
            if (element.Type == "image" && !string.IsNullOrEmpty(element.Path))
            {
                element.DataUrl = CatalogSvc.GetCollectionImageUrl(element.Path);
            }
            items.Add(BuildViewerItem(element));
        }

        await _shirtViewer.ApplyDesignBatchAsync(new { parts = designData.Parts, items });
    }

    private static object BuildViewerItem(DesignElementModel element)
    {
        return new
        {
            type = element.Type,
            text = element.Text,
            fontSize = element.FontSize,
            color = element.Color,
            font = element.Font,
            size = element.Size,
            originX = element.OriginX,
            originY = element.OriginY,
            originZ = element.OriginZ,
            dirX = element.DirX,
            dirY = element.DirY,
            dirZ = element.DirZ,
            dataUrl = element.DataUrl
        };
    }

    private static Color GetStatusColor(string? status)
    {
        return status switch
        {
            OrderStatuses.Pending => Color.Warning,
            OrderStatuses.InProgress => Color.Info,
            OrderStatuses.ReadyForPickup => Color.Primary,
            OrderStatuses.Completed => Color.Success,
            OrderStatuses.Cancelled => Color.Error,
            _ => Color.Default
        };
    }
    #endregion
}
