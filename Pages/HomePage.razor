@page "/"
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject CatalogService CatalogSvc

<PageTitle>Home - 7 Guys House of Fashion</PageTitle>

<section class="home-hero">
    <div class="home-copy">
        <span class="home-eyebrow">Custom Apparel Studio</span>
        <h1 class="home-title">
            <strong>You</strong> design.<br />
            <strong class="home-title-accent">We</strong> create.
        </h1>
        <p class="home-lead">Design your shirt in 3D, pick your sizes, and we print it for you.</p>

        <div class="home-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" DropShadow="false"
                       EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="StartCustomizing" Class="home-btn">
                Start Designing
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                       Href="/collections" Class="home-btn home-btn-outline">
                Browse Collections
            </MudButton>
        </div>

        <p class="home-track">
            Already ordered? <a href="" @onclick="TrackOrder" @onclick:preventDefault="true">Track Your Order</a>
        </p>
    </div> 

    <div class="home-stage">
        <div class="home-viewer">
            @if (_isLoading)
            {
                <div class="home-viewer-loading">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <ShirtViewerComponent @ref="_shirtViewer" OnModuleReady="OnShirtReady" ShowControls="false"
                                      BackgroundColor="@StageBackgroundColor" />
            }
        </div>

        <div class="home-stage-bar">
            <div class="home-stage-info">
                <span class="home-stage-label">Featured Design</span>
                <span class="home-stage-name">@CurrentDesignName</span>
            </div>

            <div class="home-stage-controls">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium"
                           StartIcon="@(_isPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                           OnClick="TogglePlayback" Class="home-stage-toggle">
                    @(_isPaused ? "Resume" : "Pause")
                </MudButton>
            </div>
        </div>
    </div>
</section>

@code {
    #region Properties
    private const string StageBackgroundColor = "#17181E";
    private const int RotationDelayMs = 5000;

    private ShirtViewerComponent? _shirtViewer;
    private readonly CancellationTokenSource _cts = new();
    private List<CollectionItemModel> _designs = new();
    private int _currentIndex;
    private bool _isLoading;
    private bool _isPaused;

    private string CurrentDesignName => _designs.Count > 0 ? _designs[_currentIndex].Name : "-";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("admin") || user.IsInRole("employee"))
        {
            NavManager.NavigateTo("/employee/dashboard", replace: true);
            return;
        }

        await GetFeaturedDesigns();
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
    #endregion

    #region Navigation
    private async Task<bool> IsSignedInAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated == true;
    }

    private async Task StartCustomizing()
    {
        NavManager.NavigateTo(await IsSignedInAsync() ? "/add-order" : "/register?returnUrl=%2Fadd-order");
    }

    private async Task TrackOrder()
    {
        NavManager.NavigateTo(await IsSignedInAsync() ? "/dashboard" : "/login?returnUrl=%2Fdashboard");
    }
    #endregion

    #region Featured Designs
    private async Task GetFeaturedDesigns()
    {
        _isLoading = true;

        try
        {
            var collections = await CatalogSvc.GetCollectionsAsync();
            _designs = collections
                .Where(collection => collection.IsActive && collection.DesignData?.Parts != null)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            if (_designs.Count == 0)
            {
                _designs.Add(BuildHouseDesign());
            }

            _isLoading = false;
        }
    }

    private static CollectionItemModel BuildHouseDesign()
    {
        return new CollectionItemModel
        {
            Name = "7 Guys Original",
            IsActive = true,
            DesignData = new DesignDataModel
            {
                Parts = new DesignPartsModel
                {
                    Body = "#1C1C22",
                    Sleeves = "#C8243B",
                    Collar = "#F4F1EC"
                },
                Elements = new List<DesignElementModel>
                {
                    new DesignElementModel
                    {
                        Type = "text",
                        Text = "7 GUYS",
                        Font = "Outfit",
                        FontSize = 60,
                        Color = "#F4F1EC",
                        OriginX = 0,
                        OriginY = 0.2m,
                        OriginZ = 2,
                        DirX = 0,
                        DirY = 0,
                        DirZ = -1
                    }
                }
            }
        };
    }

    private async Task OnShirtReady()
    {
        if (_shirtViewer == null) return;

        await _shirtViewer.SetAutoSpinAsync(true);
        await ShowCurrentDesign();
        _ = RunRotationLoopAsync();
    }

    private async Task TogglePlayback()
    {
        _isPaused = !_isPaused;

        if (_shirtViewer != null)
        {
            await _shirtViewer.SetAutoSpinAsync(!_isPaused);
        }
    }

    private async Task RunRotationLoopAsync()
    {
        if (_designs.Count < 2) return;

        try
        {
            while (!_cts.Token.IsCancellationRequested && _shirtViewer != null)
            {
                await Task.Delay(RotationDelayMs, _cts.Token);

                if (!_isPaused)
                {
                    _currentIndex = (_currentIndex + 1) % _designs.Count;
                    await ShowCurrentDesign();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ShowCurrentDesign()
    {
        var designData = _designs[_currentIndex].DesignData;
        if (_shirtViewer == null || designData?.Parts == null) return;

        var items = new List<object>();
        foreach (var element in designData.Elements)
        {
            items.Add(BuildViewerItem(element));
        }

        await _shirtViewer.ApplyDesignBatchAsync(new { parts = designData.Parts, items });
    }

    private static object BuildViewerItem(DesignElementModel element)
    {
        return new
        {
            type = element.Type,
            text = element.Text,
            fontSize = element.FontSize,
            color = element.Color,
            font = element.Font,
            size = element.Size,
            originX = element.OriginX,
            originY = element.OriginY,
            originZ = element.OriginZ,
            dirX = element.DirX,
            dirY = element.DirY,
            dirZ = element.DirZ
        };
    }
    #endregion
}
