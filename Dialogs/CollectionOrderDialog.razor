@using CapstoneProject.Commons
@inject OrderService OrderSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (HasDesignIn3D)
        {
            <div class="collection-order-3d">
                <ShirtViewerComponent @ref="_shirtViewer" OnModuleReady="ShowDesignIn3D" ShowControls="true" />
            </div>
            <p class="collection-order-3d-hint">Drag to rotate the shirt and scroll to zoom.</p>
        }

        <div class="collection-order-header">
            @if (!HasDesignIn3D && !string.IsNullOrEmpty(Collection.ImageUrl))
            {
                <img src="@Collection.ImageUrl" alt="@Collection.Name" class="collection-order-image" />
            }
            <div>
                <p class="collection-order-name">@Collection.Name</p>
                <p class="collection-order-price">₱@Collection.Price.ToString("N2") per piece, plus the price of your size</p>
            </div>
        </div>

        <OrderFormComponent @ref="_orderForm" OrderType="collection" CollectionId="@Collection.Id"
                            CollectionPrice="@Collection.Price" Disabled="@_isSubmitting" />
    </DialogContent>
    <DialogActions>
        <DialogButtonComponent Loading="@_isSubmitting" Submit="PlaceOrder" Cancel="Cancel" ButtonText="Place Order" />
    </DialogActions>
</MudDialog>

@code {
    #region Properties
    private const string ViewerBackgroundColor = "#0E0F13";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CollectionItemModel Collection { get; set; } = new();

    private OrderFormComponent _orderForm = default!;
    private ShirtViewerComponent? _shirtViewer;
    private bool _isSubmitting;
    private bool _hasViewerFailed;

    private bool HasDesignIn3D => Collection.DesignData?.Parts != null && !_hasViewerFailed;
    #endregion

    #region Methods
    private async Task ShowDesignIn3D()
    {
        if (_shirtViewer == null || Collection.DesignData?.Parts == null) return;

        try
        {
            await _shirtViewer.SetBackgroundColorAsync(ViewerBackgroundColor);

            var items = new List<object>();
            foreach (var element in Collection.DesignData.Elements)
            {
                items.Add(BuildViewerItem(element));
            }

            await _shirtViewer.ApplyDesignBatchAsync(new { parts = Collection.DesignData.Parts, items });
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            _hasViewerFailed = true;
            StateHasChanged();
        }
    }

    private static object BuildViewerItem(DesignElementModel element)
    {
        return new
        {
            type = element.Type,
            text = element.Text,
            fontSize = element.FontSize,
            color = element.Color,
            font = element.Font,
            size = element.Size,
            originX = element.OriginX,
            originY = element.OriginY,
            originZ = element.OriginZ,
            dirX = element.DirX,
            dirY = element.DirY,
            dirZ = element.DirZ
        };
    }

    private async Task PlaceOrder()
    {
        if (_isSubmitting) return;

        var message = _orderForm.GetValidationMessage();
        if (message != null)
        {
            Extension.ShowAlert(message, Variant.Filled, Snackbar, Severity.Warning);
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await OrderSvc.PlaceOrderAsync(_orderForm.BuildRequest());
            if (!result.IsSuccess)
            {
                Extension.ShowAlert(result.Message, Variant.Filled, Snackbar, Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    #endregion
}
