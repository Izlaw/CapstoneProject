@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="backdrop-filter: blur(20px); background: rgba(16,18,31,0.9); border-bottom: 1px solid rgba(255,255,255,0.06);">
        <a href="/" class="nav-brand" style="text-decoration: none; color: inherit;">
            7 Guys <span class="brand-accent">House of Fashion</span>
        </a>
        <MudSpacer />
        <MudButton Href="/" Variant="Variant.Text" Style="font-family:'Outfit',sans-serif; font-weight:500; color: var(--text-secondary); font-size:0.9rem;">
            Home
        </MudButton>
        <MudButton Href="/gallery" Variant="Variant.Text" Style="font-family:'Outfit',sans-serif; font-weight:500; color: var(--text-secondary); margin-left: 4px; font-size:0.9rem;">
            Gallery
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudButton Href="/dashboard" Variant="Variant.Text" Style="font-family:'Outfit',sans-serif; font-weight:500; color: var(--text-secondary); margin-left: 4px; font-size:0.9rem;">
                    My Orders
                </MudButton>
                <MudChip T="string" Size="Size.Small" Style="background: rgba(253,164,129,0.12); color: var(--accent); border: 1px solid rgba(253,164,129,0.2); border-radius:100px; margin: 0 12px; font-weight:600; font-size:0.78rem;">
                    @context.User.Identity?.Name?.Split(' ')[0]
                </MudChip>
                <MudButton OnClick="HandleLogout" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Style="border-radius:100px; font-weight:600;">
                    Logout
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Style="font-family:'Outfit',sans-serif; font-weight:500; color: var(--text-secondary); margin-left: 4px; font-size:0.9rem;">
                    Login
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <MudButton Href="/designer" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small" Class="ml-2"
                   Style="border-radius:100px; font-family:'Outfit',sans-serif; font-weight:700; letter-spacing:0.03em; padding: 0.4rem 1.25rem;">
            ✦ &nbsp;Design Now
        </MudButton>
    </MudAppBar>

    <MudMainContent Style="padding: 0; margin-top: 64px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary           = "#B4182D",
            PrimaryDarken     = "#54162B",
            PrimaryLighten    = "#FDA481",
            Secondary         = "#FDA481",
            Background        = "#181A2F",
            BackgroundGray    = "#242E49",
            Surface           = "#37415C",
            DrawerBackground  = "#242E49",
            AppbarBackground  = "rgba(24,26,47,0.85)",
            TextPrimary       = "#f1f0ff",
            TextSecondary     = "#cbd5e1",
            ActionDefault     = "#cbd5e1",
            Divider           = "rgba(180,24,45,0.2)",
            OverlayLight      = "rgba(0,0,0,0.6)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Outfit", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
            }
        }
    };

    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private CapstoneProject.Services.SupabaseService SupabaseSvc { get; set; } = default!;

    private async Task HandleLogout()
    {
        await SupabaseSvc.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}
