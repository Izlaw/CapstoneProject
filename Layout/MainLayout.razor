@inherits LayoutComponentBase
@implements IDisposable
@using CapstoneProject.Commons

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="site-appbar">
        <div class="nav-inner">
            <a href="/" class="nav-brand" aria-label="7 Guys House of Fashion home">
                <span class="brand-mark">7G</span>
                <span class="brand-name">7 Guys</span>
            </a>

            <nav class="nav-links" aria-label="Main">
                <AuthorizeView>
                    <NotAuthorized>
                        <a href="/collections" class="@GetNavLinkClass("collections")">Collections</a>
                    </NotAuthorized>
                    <Authorized>
                        @if (IsStaff(context.User))
                        {
                            <a href="/employee/dashboard" class="@GetNavLinkClass("employee/dashboard", "order-preview")">Orders</a>
                            @if (context.User.IsInRole("admin"))
                            {
                                <a href="/admin/catalog" class="@GetNavLinkClass("admin/catalog")">Catalog</a>
                            }
                        }
                        else
                        {
                            <a href="/collections" class="@GetNavLinkClass("collections")">Collections</a>
                            <a href="/dashboard" class="@GetNavLinkClass("dashboard", "order-preview")">My Orders</a>
                        }
                    </Authorized>
                </AuthorizeView>
            </nav>

            <MudSpacer />

            <div class="nav-actions">
                <AuthorizeView>
                    <NotAuthorized>
                        <a href="@GetLoginHref()" class="@GetNavLinkClass("login") nav-desktop-only">Log In</a>
                        <MudButton Href="@GetRegisterHref()" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                   Class="nav-cta nav-desktop-only">
                            Sign Up
                        </MudButton>
                    </NotAuthorized>
                    <Authorized>
                        @if (!IsStaff(context.User))
                        {
                            <MudButton Href="/add-order" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.Add" Class="nav-cta nav-new-order">
                                <span class="nav-new-order-label">New Order</span>
                            </MudButton>
                        }

                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="account-menu nav-desktop-only">
                            <ActivatorContent>
                                <button type="button" class="account-chip" aria-label="Open account menu">
                                    <MudAvatar Size="Size.Small" Class="account-avatar">@GetInitials(context.User.Identity?.Name)</MudAvatar>
                                    <span class="account-chip-name">@GetFirstName(context.User.Identity?.Name)</span>
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="account-chip-arrow" />
                                </button>
                            </ActivatorContent>
                            <ChildContent>
                                <div class="account-menu-header">
                                    <MudAvatar Size="Size.Medium" Class="account-avatar">@GetInitials(context.User.Identity?.Name)</MudAvatar>
                                    <div class="account-menu-details">
                                        <span class="account-menu-name">@(context.User.Identity?.Name ?? "-")</span>
                                        <span class="account-menu-email">@GetEmail(context.User)</span>
                                        <span class="account-menu-role">@GetRoleLabel(context.User)</span>
                                    </div>
                                </div>
                                <MudDivider />
                                <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">My Profile</MudMenuItem>
                                <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Log Out</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </Authorized>
                </AuthorizeView>

                <button type="button" class="nav-menu-toggle" aria-label="Open menu" @onclick="OpenDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Menu" />
                </button>
            </div>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_isDrawerOpen" Variant="DrawerVariant.Temporary" Anchor="Anchor.End"
               Elevation="0" Width="300px" Class="nav-drawer">
        <div class="nav-drawer-header">
            <span class="nav-drawer-title">Menu</span>
            <button type="button" class="nav-menu-toggle nav-drawer-close" aria-label="Close menu" @onclick="CloseDrawer">
                <MudIcon Icon="@Icons.Material.Filled.Close" />
            </button>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <nav class="nav-drawer-links" aria-label="Mobile">
                    <a href="/collections" class="@GetDrawerLinkClass("collections")">
                        <MudIcon Icon="@Icons.Material.Filled.Checkroom" Size="Size.Small" /> Collections
                    </a>
                    <a href="@GetLoginHref()" class="@GetDrawerLinkClass("login")">
                        <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Small" /> Log In
                    </a>
                </nav>
                <div class="nav-drawer-footer">
                    <MudButton Href="@GetRegisterHref()" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                               FullWidth="true" Class="nav-cta">
                        Sign Up
                    </MudButton>
                </div>
            </NotAuthorized>
            <Authorized>
                <div class="account-menu-header nav-drawer-account">
                    <MudAvatar Size="Size.Medium" Class="account-avatar">@GetInitials(context.User.Identity?.Name)</MudAvatar>
                    <div class="account-menu-details">
                        <span class="account-menu-name">@(context.User.Identity?.Name ?? "-")</span>
                        <span class="account-menu-email">@GetEmail(context.User)</span>
                        <span class="account-menu-role">@GetRoleLabel(context.User)</span>
                    </div>
                </div>
                <nav class="nav-drawer-links" aria-label="Mobile">
                    @if (IsStaff(context.User))
                    {
                        <a href="/employee/dashboard" class="@GetDrawerLinkClass("employee/dashboard", "order-preview")">
                            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" /> Orders
                        </a>
                        @if (context.User.IsInRole("admin"))
                        {
                            <a href="/admin/catalog" class="@GetDrawerLinkClass("admin/catalog")">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /> Catalog
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/collections" class="@GetDrawerLinkClass("collections")">
                            <MudIcon Icon="@Icons.Material.Filled.Checkroom" Size="Size.Small" /> Collections
                        </a>
                        <a href="/dashboard" class="@GetDrawerLinkClass("dashboard", "order-preview")">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" /> My Orders
                        </a>
                    }
                    <a href="/profile" class="@GetDrawerLinkClass("profile")">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> My Profile
                    </a>
                </nav>
                <div class="nav-drawer-footer">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" Class="nav-drawer-logout">
                        Log Out
                    </MudButton>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    #region Properties
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary            = "#C8243B",
            PrimaryDarken      = "#A51D31",
            PrimaryLighten     = "#E0566A",
            PrimaryContrastText = "#FFFFFF",
            Secondary          = "#F4A58A",
            SecondaryContrastText = "#0E0F13",
            Background         = "#0E0F13",
            BackgroundGray     = "#17181E",
            Surface            = "#17181E",
            DrawerBackground   = "#17181E",
            AppbarBackground   = "#0E0F13",
            AppbarText         = "#F4F1EC",
            TextPrimary        = "#F4F1EC",
            TextSecondary      = "#A9A6A0",
            ActionDefault      = "#A9A6A0",
            Divider            = "rgba(255,255,255,0.08)",
            DividerLight       = "rgba(255,255,255,0.08)",
            LinesDefault       = "rgba(255,255,255,0.08)",
            OverlayLight       = "rgba(0,0,0,0.6)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Outfit", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
            }
        }
    };

    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private CapstoneProject.Services.SupabaseService SupabaseSvc { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string _currentPath = string.Empty;
    private bool _isDrawerOpen;
    #endregion

    #region Lifecycle
    protected override void OnInitialized()
    {
        _currentPath = GetCurrentPath();
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
    #endregion

    #region Methods
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = GetCurrentPath();
        _isDrawerOpen = false;
        StateHasChanged();
    }

    private string GetCurrentPath()
    {
        return NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].Trim('/');
    }

    private bool IsActivePath(string[] paths)
    {
        foreach (var path in paths)
        {
            var isExactMatch = string.Equals(_currentPath, path, StringComparison.OrdinalIgnoreCase);
            var isChildPage = _currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);

            if (isExactMatch || isChildPage) return true;
        }

        return false;
    }

    private string GetNavLinkClass(params string[] paths)
    {
        return IsActivePath(paths) ? "nav-link nav-link-active" : "nav-link";
    }

    private string GetDrawerLinkClass(params string[] paths)
    {
        return IsActivePath(paths) ? "nav-drawer-link nav-drawer-link-active" : "nav-drawer-link";
    }

    private string GetLoginHref()
    {
        return BuildAuthHref("/login");
    }

    private string GetRegisterHref()
    {
        return BuildAuthHref("/register");
    }

    private string BuildAuthHref(string authPage)
    {
        var isOnAuthPage = _currentPath == "login" || _currentPath == "register";
        if (isOnAuthPage || _currentPath.Length == 0) return authPage;

        var returnUrl = "/" + NavManager.ToBaseRelativePath(NavManager.Uri);
        return $"{authPage}?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private void OpenDrawer()
    {
        _isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        _isDrawerOpen = false;
    }

    private static bool IsStaff(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.IsInRole("admin") || user.IsInRole("employee");
    }

    private static string GetFirstName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "-";

        return fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
    }

    private static string GetEmail(System.Security.Claims.ClaimsPrincipal user)
    {
        var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
        return string.IsNullOrWhiteSpace(email) ? "-" : email;
    }

    private static string GetRoleLabel(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("admin")) return "Admin";
        if (user.IsInRole("employee")) return "Employee";
        return "Customer";
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "-";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts[0][0];
        var last = parts.Length > 1 ? parts[^1][0] : (char?)null;

        return last is null ? char.ToUpper(first).ToString() : $"{char.ToUpper(first)}{char.ToUpper(last.Value)}";
    }

    private async Task Logout()
    {
        try
        {
            await SupabaseSvc.LogoutAsync();
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Failed to log out. Please try again.", Variant.Filled, Snackbar, Severity.Error);
        }
    }
    #endregion
}
