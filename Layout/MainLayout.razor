@inherits LayoutComponentBase
@implements IDisposable
@using CapstoneProject.Commons

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="site-appbar">
        <a href="/" class="nav-brand">
            7 Guys <span class="brand-accent">House of Fashion</span>
        </a>
        <MudSpacer />
        <MudButton Href="/" Variant="Variant.Text" Class="@GetNavClass("", "nav-secondary")">
            Home
        </MudButton>
        <MudButton Href="/collections" Variant="Variant.Text" Class="@GetNavClass("collections", "nav-secondary")">
            Collections
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudButton Href="/dashboard" Variant="Variant.Text" Class="@GetNavClass("dashboard")">
                    My Orders
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Class="@GetNavClass("login")">
                    Login
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Roles="admin">
            <MudButton Href="/admin/catalog" Variant="Variant.Text" Class="@GetNavClass("admin/catalog")">
                Catalog
            </MudButton>
        </AuthorizeView>

        <MudButton Href="/add-order" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small" DropShadow="false" Class="primary-action-btn">
            New Order
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="account-menu">
                    <ActivatorContent>
                        <MudAvatar Size="Size.Medium" Class="account-avatar">@GetInitials(context.User.Identity?.Name)</MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="account-menu-header">
                            <span class="account-menu-name">@(context.User.Identity?.Name ?? "-")</span>
                            <span class="account-menu-role">Signed in</span>
                        </div>
                        <MudDivider />
                        <MudMenuItem OnClick="Logout">Logout</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    #region Properties
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary            = "#B4182D",
            PrimaryDarken      = "#8F1222",
            PrimaryLighten     = "#CF2038",
            PrimaryContrastText = "#FFFFFF",
            Secondary          = "#FDA481",
            SecondaryContrastText = "#10121F",
            Background         = "#10121F",
            BackgroundGray     = "#1A1E38",
            Surface            = "#242E49",
            DrawerBackground   = "#1A1E38",
            AppbarBackground   = "#1A1E38",
            AppbarText         = "#F1F0FF",
            TextPrimary        = "#F1F0FF",
            TextSecondary      = "#B8B7D0",
            ActionDefault      = "#B8B7D0",
            Divider            = "rgba(255,255,255,0.08)",
            DividerLight       = "rgba(255,255,255,0.08)",
            LinesDefault       = "rgba(255,255,255,0.08)",
            OverlayLight       = "rgba(0,0,0,0.6)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Outfit", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
            }
        }
    };

    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private CapstoneProject.Services.SupabaseService SupabaseSvc { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string _currentPath = string.Empty;
    #endregion

    #region Lifecycle
    protected override void OnInitialized()
    {
        _currentPath = GetCurrentPath();
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
    #endregion

    #region Methods
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = GetCurrentPath();
        StateHasChanged();
    }

    private string GetCurrentPath()
    {
        return NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].Trim('/');
    }

    private string GetNavClass(string path, string extraClass = "")
    {
        var isActive = string.Equals(_currentPath, path, StringComparison.OrdinalIgnoreCase);
        return $"nav-btn {extraClass} {(isActive ? "nav-btn-active" : string.Empty)}".Trim();
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "-";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts[0][0];
        var last = parts.Length > 1 ? parts[^1][0] : (char?)null;

        return last is null ? char.ToUpper(first).ToString() : $"{char.ToUpper(first)}{char.ToUpper(last.Value)}";
    }

    private async Task Logout()
    {
        try
        {
            await SupabaseSvc.LogoutAsync();
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Extension.ShowAlert("Failed to log out. Please try again.", Variant.Filled, Snackbar, Severity.Error);
        }
    }
    #endregion
}
