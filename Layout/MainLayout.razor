@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="glass-appbar">
        <a href="/" class="nav-brand">
            7 Guys <span class="brand-accent">House of Fashion</span>
        </a>
        <MudSpacer />
        <MudButton Href="/" Variant="Variant.Text" Class="nav-btn">
            Home
        </MudButton>
        <MudButton Href="/gallery" Variant="Variant.Text" Class="nav-btn ml-1">
            Gallery
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudButton Href="/dashboard" Variant="Variant.Text" Class="nav-btn ml-1">
                    My Orders
                </MudButton>
                <MudChip T="string" Size="Size.Small" Class="user-chip">
                    @context.User.Identity?.Name?.Split(' ')[0]
                </MudChip>
                <MudButton OnClick="HandleLogout" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Class="action-btn-outlined">
                    Logout
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Class="nav-btn ml-1">
                    Login
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <MudButton Href="/designer" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small" Class="primary-action-btn ml-2">
            ✦ &nbsp;Design Now
        </MudButton>
    </MudAppBar>

    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary           = "#B51A2B",
            PrimaryDarken     = "#541A2E",
            PrimaryLighten    = "#FFA586",
            Secondary         = "#FFA586",
            Background        = "#161E2F",
            BackgroundGray    = "#242E49",
            Surface           = "#384358",
            DrawerBackground  = "#242E49",
            AppbarBackground  = "rgba(84,26,46,0.85)", 
            TextPrimary       = "#f1f0ff",
            TextSecondary     = "#cbd5e1",
            ActionDefault     = "#cbd5e1",
            Divider           = "rgba(181,26,43,0.2)",
            OverlayLight      = "rgba(0,0,0,0.6)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Outfit", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
            }
        }
    };

    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private CapstoneProject.Services.SupabaseService SupabaseSvc { get; set; } = default!;

    private async Task HandleLogout()
    {
        await SupabaseSvc.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}
